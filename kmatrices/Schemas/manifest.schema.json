{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrekmatrices.org/schemas/manifest.schema.json",
  "title": "QRE web catalogue manifest",
  "type": "object",
  "required": ["schemaVersion", "engine", "files"],
  "properties": {
    "schemaVersion": { "const": "1.4.0" },
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "QREKMatrices" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "affineType", "rank", "path", "diagramCount", "families"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "affineType": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "pattern": "^[^/]+\\.json$" },
          "diagramCount": { "type": "integer", "minimum": 0 },
          "families": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
