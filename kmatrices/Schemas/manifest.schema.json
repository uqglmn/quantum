{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qrekmatrices.org/schemas/manifest.schema.json",
  "title": "QRE web catalogue manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "engine",
    "files",
    "families"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.8.0"
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "QREKMatrices"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "affineType",
          "rank",
          "path",
          "diagramCount",
          "layout",
          "detailBasePath",
          "detailCount",
          "families"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "affineType": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[^/]+\\.json$"
          },
          "diagramCount": {
            "type": "integer",
            "minimum": 0
          },
          "layout": {
            "const": "lazy-v1"
          },
          "detailBasePath": {
            "type": "string",
            "pattern": "^details/[^/]+$"
          },
          "detailCount": {
            "type": "integer",
            "minimum": 0
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifestFamilyRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "parameterMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "expression.schema.json#/$defs/expression"
      }
    },
    "sourceAnchor": {
      "type": "object",
      "required": [
        "source",
        "anchor",
        "role"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "familyFormulaDefinition": {
      "type": "object",
      "required": [
        "definitionId",
        "label",
        "latex",
        "expression"
      ],
      "properties": {
        "definitionId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "$ref": "expression.schema.json#/$defs/expression"
        }
      },
      "additionalProperties": false
    },
    "familyFormula": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "latex",
        "expression",
        "definitions",
        "assumptionsLatex",
        "sourceAnchors"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "published",
            "computational",
            "pending"
          ]
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "$ref": "expression.schema.json#/$defs/expression"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/familyFormulaDefinition"
          }
        },
        "assumptionsLatex": {
          "type": "string"
        },
        "sourceAnchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAnchor"
          }
        }
      },
      "additionalProperties": false
    },
    "familyParameterDomain": {
      "type": "object",
      "required": [
        "parameters",
        "constraints",
        "branches"
      ],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "label",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "integer"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "constraintId",
              "kind",
              "latex"
            ],
            "properties": {
              "constraintId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "latex": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "branchId",
              "label",
              "kind",
              "regime",
              "description",
              "constraintsLatex",
              "formula",
              "properties",
              "verification"
            ],
            "properties": {
              "branchId": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "generic",
                  "boundary",
                  "corner",
                  "endpoint",
                  "exceptional",
                  "classification"
                ]
              },
              "regime": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "constraintsLatex": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "formula": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/familyFormula"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "properties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/familyProperty"
                }
              },
              "verification": {
                "$ref": "#/$defs/familyBranchVerification"
              },
              "formulaStatus": {
                "type": "string",
                "minLength": 1
              },
              "propertyStatus": {
                "type": "string",
                "minLength": 1
              },
              "boundaryStatus": {
                "type": "string",
                "minLength": 1
              },
              "deformationStatus": {
                "type": "string",
                "minLength": 1
              },
              "domainAuditStatus": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "familyProperty": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "latex"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "sourceIdentity",
            "computed",
            "computedExact",
            "verified",
            "conditional"
          ]
        },
        "latex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "familyBranchVerification": {
      "type": "object",
      "required": [
        "status",
        "level",
        "equation",
        "method"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "conditional",
            "notComputed"
          ]
        },
        "level": {
          "enum": [
            "exactSymbolic",
            "exactSample",
            "numericSample",
            "notComputed"
          ]
        },
        "equation": {
          "enum": [
            "Standard",
            "Transposed"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "schematicToken": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "node",
            "link"
          ]
        },
        "fill": {
          "enum": [
            "black",
            "white"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "enum": [
            "above",
            "below",
            "left",
            "right"
          ]
        },
        "style": {
          "enum": [
            "solid",
            "dashed",
            "double"
          ]
        },
        "arrow": {
          "enum": [
            "left",
            "right",
            null
          ]
        }
      }
    },
    "schematicCap": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": "arc"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "node",
                "fork"
              ]
            },
            "fill": {
              "enum": [
                "black",
                "white"
              ]
            },
            "label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "top": {
              "type": "object"
            },
            "bottom": {
              "type": "object"
            },
            "tau": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "schematicBrace": {
      "type": "object",
      "required": [
        "from",
        "to",
        "side"
      ],
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "side": {
          "enum": [
            "above",
            "below"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "schematicVariant": {
      "type": "object",
      "required": [
        "variantId",
        "label",
        "layout",
        "braces"
      ],
      "properties": {
        "variantId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "enum": [
            "linear",
            "folded",
            "cycle"
          ]
        },
        "capLeft": {
          "$ref": "#/$defs/schematicCap"
        },
        "capRight": {
          "$ref": "#/$defs/schematicCap"
        },
        "row": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schematicToken"
          }
        },
        "top": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schematicToken"
          }
        },
        "bottom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schematicToken"
          }
        },
        "ring": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schematicToken"
          }
        },
        "rungs": {
          "type": "boolean"
        },
        "tau": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "braces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schematicBrace"
          }
        }
      }
    },
    "familyRecord": {
      "type": "object",
      "required": [
        "familyId",
        "title",
        "affineTypes",
        "description",
        "contentStatus",
        "regimes",
        "parameterOrder",
        "parameterDomain",
        "generalFormula",
        "regimeFormulas",
        "properties",
        "sourceAnchors",
        "instanceIds",
        "schematic"
      ],
      "properties": {
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "affineTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "contentStatus": {
          "type": "string",
          "minLength": 1
        },
        "regimes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "parameterOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "parameterDomain": {
          "$ref": "#/$defs/familyParameterDomain"
        },
        "generalFormula": {
          "oneOf": [
            {
              "$ref": "#/$defs/familyFormula"
            },
            {
              "type": "null"
            }
          ]
        },
        "regimeFormulas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "regime",
              "formula"
            ],
            "properties": {
              "regime": {
                "type": "string",
                "minLength": 1
              },
              "formula": {
                "$ref": "#/$defs/familyFormula"
              }
            },
            "additionalProperties": false
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/familyProperty"
          }
        },
        "sourceAnchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAnchor"
          }
        },
        "instanceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "schematic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schematicVariant"
          }
        }
      },
      "additionalProperties": false
    },
    "manifestFamilyRecord": {
      "type": "object",
      "required": [
        "familyId",
        "title",
        "affineTypes",
        "description",
        "contentStatus",
        "regimes",
        "parameterOrder",
        "parameterDomain",
        "generalFormula",
        "regimeFormulas",
        "properties",
        "sourceAnchors",
        "schematic",
        "catalogues"
      ],
      "properties": {
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "affineTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "contentStatus": {
          "type": "string",
          "minLength": 1
        },
        "regimes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "parameterOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "parameterDomain": {
          "$ref": "#/$defs/familyParameterDomain"
        },
        "generalFormula": {
          "oneOf": [
            {
              "$ref": "#/$defs/familyFormula"
            },
            {
              "type": "null"
            }
          ]
        },
        "regimeFormulas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "regime",
              "formula"
            ],
            "properties": {
              "regime": {
                "type": "string",
                "minLength": 1
              },
              "formula": {
                "$ref": "#/$defs/familyFormula"
              }
            },
            "additionalProperties": false
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/familyProperty"
          }
        },
        "sourceAnchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAnchor"
          }
        },
        "schematic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schematicVariant"
          }
        },
        "catalogues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "catalogueId",
              "affineType",
              "rank",
              "path"
            ],
            "properties": {
              "catalogueId": {
                "type": "string"
              },
              "affineType": {
                "type": "string"
              },
              "rank": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}