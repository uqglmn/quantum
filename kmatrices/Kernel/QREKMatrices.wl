KMatrixCatalogue[] := $catalogue;

Options[KMatrix] = {
  "Method" -> Automatic,
  "Family" -> Automatic,
  "Parameters" -> <||>,
  "DressingMatrix" -> Identity,
  "QuantumParameter" -> q,
  "CParameters" -> Automatic,
  "SParameters" -> Automatic,
  "ScalingParameter" -> 1,
  "Equation" -> Automatic,
  "NormalizeAt" -> None,
  "SimplifyFunction" -> Together
};

bareBDC1[n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {lambda, mu, labels, id, k1, k2, block1, block2},
  lambda = Lookup[params, "Lambda", If[r == n,
    Symbol["\[Lambda]"], I q^(n - r + 1)]];
  mu = Lookup[params, "Mu", q^-ell];
  labels = Join[Range[-n, -1], Range[1, n]];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  block1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  block2 = Sum[
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] + matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (block1 + block2/k2)
];

bareNonQuasiPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, id, lambda, mu, nu, k1, k2, bar, a, b, c, d, m1, m2, m3,
   maxEll},
  maxEll = If[family === "C**.1", n - 2, n - 3];
  If[!MemberQ[{"B*.1", "tB*.1", "C**.1"}, family] || r =!= ell + 2 ||
      !(1 <= ell <= maxEll), Return[$Failed]];
  labels = If[family === "C**.1", Range[-n, n],
    Join[Range[-n, -1], Range[1, n]]];
  id = IdentityMatrix[Length[labels], SparseArray];
  lambda = Lookup[params, "Lambda", Switch[family,
    "B*.1", I q^(n - r + 1),
    "tB*.1", I q^(n - r),
    "C**.1", I q^(n + 1/2 - r)
  ]];
  mu = Lookup[params, "Mu", If[family === "B*.1", q^-ell, q^(-ell - 1)]];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 + If[family === "B*.1", 1, -1] (mu x)^-1;
  bar = n + 1 - ell;
  {a, b, c, d} = {2 - bar, bar - 2, 1 - bar, bar - 1};
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, bar - 1, n}
  ];
  If[family === "B*.1",
    m2 = lambda matrixUnit[labels, a, a] +
      lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] +
      matrixUnit[labels, b, a] - mu u matrixUnit[labels, c, c] -
      (mu u)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] +
      matrixUnit[labels, d, c];
    m3 = matrixUnit[labels, c, a] - matrixUnit[labels, a, c] +
      lambda^-1 (matrixUnit[labels, c, b] - matrixUnit[labels, b, c]) +
      (mu u)^-1 (matrixUnit[labels, a, d] - matrixUnit[labels, d, a] +
        lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b])),
    m2 = -lambda matrixUnit[labels, a, a] +
      lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] -
      matrixUnit[labels, b, a] - mu u matrixUnit[labels, c, c] +
      (mu u)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] -
      matrixUnit[labels, d, c];
    m3 = -matrixUnit[labels, c, a] + matrixUnit[labels, a, c] +
      lambda^-1 (matrixUnit[labels, c, b] + matrixUnit[labels, b, c]) -
      (mu u)^-1 (matrixUnit[labels, a, d] + matrixUnit[labels, d, a] +
        lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b]))
  ];
  id + (u - u^-1)/k1[u] (m1 +
    (k2[u] m2 + (nu + nu^-1) m3)/
      (k2[-nu^-2 u] k2[-nu^2 u]))
];

bareNonQuasiBEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, id, lambda, mu = 1, nu0, nu1, k1, k2, alpha, m2,
   m3minus, m3plus, denominator},
  If[{ell, r} =!= {0, 2} || n < 2, Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  id = IdentityMatrix[2 n, SparseArray];
  lambda = Lookup[params, "Lambda", I q^(n - 1)];
  nu0 = Lookup[params, "Nu0", Symbol["\[Nu]0"]];
  nu1 = Lookup[params, "Nu1", Symbol["\[Nu]1"]];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 + (mu x)^-1;
  alpha[x_] := (nu1 + nu1^-1) x - (nu0 + nu0^-1);
  m2 = Sum[
    lambda matrixUnit[labels, -i, -i] +
      lambda^-1 matrixUnit[labels, i, i] + matrixUnit[labels, -i, i] +
      matrixUnit[labels, i, -i], {i, n - 1, n}];
  m3minus = matrixUnit[labels, -n, n - 1] -
      matrixUnit[labels, n - 1, -n] +
    lambda (matrixUnit[labels, -n, 1 - n] -
      matrixUnit[labels, 1 - n, -n] +
      (nu1 + nu1^-1) matrixUnit[labels, -n, -n]);
  m3plus = matrixUnit[labels, n, 1 - n] -
      matrixUnit[labels, 1 - n, n] +
    lambda^-1 (matrixUnit[labels, n, n - 1] -
      matrixUnit[labels, n - 1, n] -
      (nu1 + nu1^-1) matrixUnit[labels, n, n]);
  denominator = k1[nu0 u/nu1] k1[nu1 u/nu0]
    k1[nu0 nu1 u] k1[u/(nu0 nu1)];
  id + (u - u^-1) lambda^2 u^2/denominator *
    (k1[u] k2[u] m2 + alpha[u/lambda] m3minus +
      alpha[lambda/u] m3plus)
];

bareNonQuasiCMinusEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, id, lambda, mu, nu, k1, k2, m1, m2, m3, denominator},
  If[{ell, r} =!= {n - 1, n} || n < 2, Return[$Failed]];
  labels = Range[-n, n];
  id = IdentityMatrix[2 n + 1, SparseArray];
  lambda = Lookup[params, "Lambda", I q^(1/2)];
  mu = Lookup[params, "Mu", q^-n];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[x_] := lambda mu - x;
  (* This endpoint is written in the source convention
     k2(x)=lambda^-1+(mu x)^-1; the main C**.1 implementation absorbs
     the displayed argument -x into its local definition instead. *)
  k2[x_] := lambda^-1 + (mu x)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] +
      matrixUnit[labels, i, i], {i, 1, n}];
  m2 = -mu u matrixUnit[labels, -1, -1] +
    (mu u)^-1 matrixUnit[labels, 1, 1] +
    matrixUnit[labels, -1, 1] - matrixUnit[labels, 1, -1];
  m3 = (-1)^(1/4) k1[u^-1] (
      u^-1 (matrixUnit[labels, 0, 1] -
        I matrixUnit[labels, 1, 0]) -
      mu (matrixUnit[labels, 0, -1] +
        I matrixUnit[labels, -1, 0])) +
    (* KCB1xx in the verification notebook has nu+nu^-1 here; the
       surviving minus sign in nqs_temp.tex is a manuscript typo. *)
    Sqrt[1 + q] (nu + nu^-1) mu u^-1 matrixUnit[labels, 0, 0];
  denominator = k1[-nu^-2 u^-1] k1[-nu^2 u^-1] k2[-u];
  id + (u - u^-1)/k1[u] (m1 +
    (k1[u^-1]^2 m2 + Sqrt[1 + q] (nu + nu^-1) m3)/
      denominator)
];

bareNonQuasiTCMinusEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, special = "0p", id, lambda, mu, nu, x = u^2, k1, k2,
   h1, m1, m3, denominator},
  If[{ell, r} =!= {0, 1} || n < 2, Return[$Failed]];
  labels = Join[Range[-n, -1], {special}, Range[1, n]];
  id = IdentityMatrix[2 n + 1, SparseArray];
  lambda = Lookup[params, "Lambda", I q^n];
  mu = Lookup[params, "Mu", q^(-1/2)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  h1[y_] := k1[y^-1]/k1[y];
  m1 = lambda matrixUnit[labels, -n, -n] +
    lambda^-1 matrixUnit[labels, n, n] +
    matrixUnit[labels, -n, n] + matrixUnit[labels, n, -n];
  m3 = mu u (matrixUnit[labels, n, special] -
      matrixUnit[labels, special, n] +
      lambda (matrixUnit[labels, -n, special] -
        matrixUnit[labels, special, -n]) -
      u Sqrt[1 + q] (nu + nu^-1) mu lambda/k1[x] *
        matrixUnit[labels, special, special]);
  denominator = k1[-nu^-2 x] k1[-nu^2 x] k2[x];
  id + (x - x^-1) (k1[x] m1 +
      Sqrt[1 + q] (nu + nu^-1) m3)/denominator +
    (x h1[x] - 1) matrixUnit[labels, special, special]
];

bareNonQuasiCStarEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, special = "0p", id, lambda, mu, nu, x = u^2, k1, k2,
   h1, m2, offDiagonal, numerator, denominator},
  If[{ell, r} =!= {0, 1} || n < 2, Return[$Failed]];
  labels = Join[Range[-n, -1], {0, special}, Range[1, n]];
  id = IdentityMatrix[2 n + 2, SparseArray];
  lambda = Lookup[params, "Lambda", q^(n - 1/2)];
  mu = Lookup[params, "Mu", q^(-1/2)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  h1[y_] := k1[y^-1]/k1[y];
  m2 = lambda matrixUnit[labels, -n, -n] +
    lambda^-1 matrixUnit[labels, n, n] +
    matrixUnit[labels, -n, n] + matrixUnit[labels, n, -n];
  offDiagonal = matrixUnit[labels, special, n] -
    matrixUnit[labels, n, special] -
    lambda matrixUnit[labels, -n, special] +
    lambda matrixUnit[labels, special, -n];
  (* KBB1xx separates the 0' diagonal term from M3.  The typeset draft
     accidentally places it inside M3, introducing extra powers of
     Sqrt[1+q] and nu+nu^-1. *)
  numerator = k1[x] m2 +
    Sqrt[1 + q] (nu + nu^-1) mu u offDiagonal -
    lambda mu u^2/k1[x] (mu + mu^-1) (nu + nu^-1)^2 *
      matrixUnit[labels, special, special];
  denominator = k1[-nu^2 x] k1[-nu^-2 x] k2[x];
  id + (x - x^-1) numerator/denominator +
    (x h1[x] - 1) matrixUnit[labels, special, special]
];

bareNonQuasiSquaredPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, special = "0p", id, lambda, mu, nu, x = u^2, k1, k2,
   bar, a, b, c, d, m1, m2, m3},
  If[!MemberQ[{"tC**.1", "C*.1"}, family] ||
      !supportedNonQuasiFormulaQ[family, n, ell, r], Return[$Failed]];
  labels = If[family === "tC**.1",
    Join[Range[-n, -1], {special}, Range[1, n]],
    Join[Range[-n, -1], {0, special}, Range[1, n]]];
  id = IdentityMatrix[Length[labels], SparseArray];
  lambda = Lookup[params, "Lambda", If[family === "tC**.1",
    I q^(n + 1 - r), q^(n - r + 1/2)]];
  mu = Lookup[params, "Mu", q^(-ell - 1/2)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  bar = n + 1 - ell;
  {a, b, c, d} = {2 - bar, bar - 2, 1 - bar, bar - 1};
  m1 = Sum[
    lambda mu x matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, bar - 1, n}
  ];
  m2 = lambda matrixUnit[labels, a, a] +
    lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] +
    matrixUnit[labels, b, a] - mu x matrixUnit[labels, c, c] -
    (mu x)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] +
    matrixUnit[labels, d, c];
  m3 = matrixUnit[labels, c, a] - matrixUnit[labels, a, c] +
    lambda^-1 (matrixUnit[labels, c, b] - matrixUnit[labels, b, c]) +
    (mu x)^-1 (matrixUnit[labels, a, d] - matrixUnit[labels, d, a] +
      lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b]));
  id + (u^2 - u^-2)/k1[x] (m1 +
    (k2[x] m2 + (nu + nu^-1) m3)/
      (k2[-nu^-2 x] k2[-nu^2 x])) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

bareA1[n_Integer] := IdentityMatrix[n + 1, SparseArray];

bareA2[n_Integer, q_] := Module[{size = n + 1},
  If[!EvenQ[size] || size <= 2, Return[$Failed]];
  SparseArray@Sum[
    q^(1/2) matrixUnit[Range[size], 2 i - 1, 2 i] -
      q^(-1/2) matrixUnit[Range[size], 2 i, 2 i - 1],
    {i, 1, size/2}
  ]
];

bareA4[n_Integer, u_] := Module[{size = n + 1, half},
  If[!EvenQ[size] || size <= 2, Return[$Failed]];
  half = size/2;
  SparseArray@Sum[
    u matrixUnit[Range[size], i + half, i] +
      matrixUnit[Range[size], i, i + half],
    {i, 1, half}
  ]
];

bareA3[n_Integer, ell_Integer, r_Integer, t_Integer, u_, params_Association] := Module[
  {size = n + 1, lambda, mu, labels, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r && 2 r <= t <= size), Return[$Failed]];
  lambda = Lookup[params, "Lambda", Symbol["\[Lambda]"]];
  mu = Lookup[params, "Mu", Symbol["\[Mu]"]];
  labels = Range[size];
  id = IdentityMatrix[size, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[lambda mu u matrixUnit[labels, i, i], {i, 1, ell}] +
    Sum[matrixUnit[labels, i, i], {i, t - ell + 1, size}];
  m2 = Sum[
    lambda matrixUnit[labels, i, i] +
      lambda^-1 matrixUnit[labels, t + 1 - i, t + 1 - i] +
      matrixUnit[labels, i, t + 1 - i] + matrixUnit[labels, t + 1 - i, i],
    {i, ell + 1, r}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareBD1[type_String, n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[type === "B.1", Range[-n, n], Join[Range[-n, -1], Range[1, n]]];
  lambda = Lookup[params, "Lambda", q^(Length[labels]/2 - r)];
  mu = Lookup[params, "Mu", q^-ell];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] + matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareNonQuasiBD1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, id, lambda, mu, nu, k1, k2, bar, a, b, c, d, m1, m2, m3},
  If[!MemberQ[{"B.1", "D.1"}, family] || r =!= ell + 2 ||
      !(1 <= ell <= n - 2), Return[$Failed]];
  labels = If[family === "B.1", Range[-n, n],
    Join[Range[-n, -1], Range[1, n]]];
  id = IdentityMatrix[Length[labels], SparseArray];
  lambda = Lookup[params, "Lambda", q^(Length[labels]/2 - r)];
  mu = Lookup[params, "Mu", q^-ell];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 + (mu x)^-1;
  bar = n + 1 - ell;
  {a, b, c, d} = {2 - bar, bar - 2, 1 - bar, bar - 1};
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, bar - 1, n}];
  m2 = lambda matrixUnit[labels, a, a] +
    lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] +
    matrixUnit[labels, b, a] - mu u matrixUnit[labels, c, c] -
    (mu u)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] +
    matrixUnit[labels, d, c];
  m3 = matrixUnit[labels, c, a] - matrixUnit[labels, a, c] +
    lambda^-1 (matrixUnit[labels, c, b] - matrixUnit[labels, b, c]) +
    (mu u)^-1 (matrixUnit[labels, a, d] - matrixUnit[labels, d, a] +
      lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b]));
  id + (u - u^-1)/k1[u] (m1 +
    (k2[u] m2 + (nu + nu^-1) m3)/
      (k2[-nu^-2 u] k2[-nu^2 u]))
];

bareNonQuasiBD1Endpoint02[family_String, n_Integer, ell_Integer,
    r_Integer, u_, q_, params_Association] := Module[
  {labels, id, lambda, mu = 1, nu0, nu1, k1, k2, alpha, m2,
   m3minus, m3plus, denominator},
  If[!MemberQ[{"B.1", "D.1"}, family] || {ell, r} =!= {0, 2} ||
      n < 2, Return[$Failed]];
  labels = If[family === "B.1", Range[-n, n],
    Join[Range[-n, -1], Range[1, n]]];
  id = IdentityMatrix[Length[labels], SparseArray];
  lambda = Lookup[params, "Lambda", q^(Length[labels]/2 - 2)];
  nu0 = Lookup[params, "Nu0", Symbol["\[Nu]0"]];
  nu1 = Lookup[params, "Nu1", Symbol["\[Nu]1"]];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 + (mu x)^-1;
  alpha[x_] := (nu1 + nu1^-1) x - (nu0 + nu0^-1);
  m2 = Sum[
    lambda matrixUnit[labels, -i, -i] +
      lambda^-1 matrixUnit[labels, i, i] + matrixUnit[labels, -i, i] +
      matrixUnit[labels, i, -i], {i, n - 1, n}];
  m3minus = matrixUnit[labels, -n, n - 1] -
      matrixUnit[labels, n - 1, -n] +
    lambda (matrixUnit[labels, -n, 1 - n] -
      matrixUnit[labels, 1 - n, -n] +
      (nu1 + nu1^-1) matrixUnit[labels, -n, -n]);
  m3plus = matrixUnit[labels, n, 1 - n] -
      matrixUnit[labels, 1 - n, n] +
    lambda^-1 (matrixUnit[labels, n, n - 1] -
      matrixUnit[labels, n - 1, n] -
      (nu1 + nu1^-1) matrixUnit[labels, n, n]);
  denominator = k1[nu0 u/nu1] k1[nu1 u/nu0]
    k1[nu0 nu1 u] k1[u/(nu0 nu1)];
  id + (u - u^-1) lambda^2 u^2/denominator *
    (k1[u] k2[u] m2 + alpha[u/lambda] m3minus +
      alpha[lambda/u] m3plus)
];

bareNonQuasiB1EndpointRight[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels = Range[-n, n], id, lambda, mu, nu, k1, k2, qTwo,
   coefficient, m1, m2, m3},
  If[{ell, r} =!= {n - 1, n} || n < 2, Return[$Failed]];
  id = IdentityMatrix[2 n + 1, SparseArray];
  lambda = Lookup[params, "Lambda", q^(1/2)];
  mu = Lookup[params, "Mu", q^(1 - n)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 + (mu x)^-1;
  qTwo = q^(1/2) + q^(-1/2);
  coefficient = q^(1/4) (nu - nu^-1) Sqrt[qTwo];
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, 1, n}];
  m2 = -mu u matrixUnit[labels, -1, -1] -
    (mu u)^-1 matrixUnit[labels, 1, 1] +
    matrixUnit[labels, -1, 1] + matrixUnit[labels, 1, -1];
  m3 = k1[u^-1] (u^-1 (matrixUnit[labels, 0, 1] +
      matrixUnit[labels, 1, 0]) - mu (matrixUnit[labels, -1, 0] +
      matrixUnit[labels, 0, -1])) -
    coefficient mu u^-1 matrixUnit[labels, 0, 0];
  id + (u - u^-1)/k1[u] (m1 +
    (k1[u^-1]^2 m2 + coefficient m3)/
      (k1[nu^2 u^-1] k1[nu^-2 u^-1] k2[u]))
];

bareC1[n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  lambda = Lookup[params, "Lambda",
    If[r == n, Symbol["\[Lambda]"], q^(n + 1 - r)]];
  mu = Lookup[params, "Mu",
    If[ell == 0, Symbol["\[Mu]"], q^(-ell - 1)]];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 - (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    -lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] - matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareNonQuasiC1[n_Integer, ell_Integer, r_Integer, u_, q_,
    params_Association] := Module[
  {labels, lambda, mu, nu, id, k1, k2, bar, a, b, c, d, m1, m2, m3},
  If[!(r === ell + 2 && 1 <= ell <= n - 3), Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  lambda = Lookup[params, "Lambda", q^(n + 1 - r)];
  mu = Lookup[params, "Mu", q^(-ell - 1)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  id = IdentityMatrix[2 n, SparseArray];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 - (mu x)^-1;
  bar = n + 1 - ell;
  {a, b, c, d} = {2 - bar, bar - 2, 1 - bar, bar - 1};
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, bar - 1, n}
  ];
  m2 = -lambda matrixUnit[labels, a, a] +
    lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] -
    matrixUnit[labels, b, a] - mu u matrixUnit[labels, c, c] +
    (mu u)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] -
    matrixUnit[labels, d, c];
  m3 = -matrixUnit[labels, c, a] + matrixUnit[labels, a, c] +
    lambda^-1 (matrixUnit[labels, c, b] + matrixUnit[labels, b, c]) -
    (mu u)^-1 (matrixUnit[labels, a, d] + matrixUnit[labels, d, a] +
      lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b]));
  id + (u - u^-1)/k1[u] (m1 +
    (k2[u] m2 + (nu + nu^-1) m3)/
      (k2[-nu^-2 u] k2[-nu^2 u]))
];

bareC2[n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, epsilon},
  If[!(0 <= ell <= r <= n && EvenQ[r - ell]), Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  lambda = Lookup[params, "Lambda", q^(n - r)];
  mu = Lookup[params, "Mu", q^-ell];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    epsilon = (-1)^(i + n + 1 - ell);
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      epsilon (matrixUnit[labels, i, -i - epsilon] +
        matrixUnit[labels, -i - epsilon, i]),
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareBD2[type_String, n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, size, lambda, mu, id, k1, k2, m1, m2, epsilon},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[type === "B.2", Range[-n, n], Join[Range[-n, -1], Range[1, n]]];
  size = Length[labels];
  lambda = Lookup[params, "Lambda",
    If[type === "D.2" && MemberQ[{n - 1, n}, r],
      Symbol["\[Lambda]"], q^(size/2 - r - 1)]];
  mu = Lookup[params, "Mu",
    If[MemberQ[{0, 1}, ell], Symbol["\[Mu]"], q^(-ell + 1)]];
  id = IdentityMatrix[size, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 - (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = If[ell == 1,
      -u^-1 (mu - mu^-1) matrixUnit[labels, n, n], 0 id] +
    If[type === "D.2" && r == n - 1,
      -(lambda - lambda^-1) matrixUnit[labels, 1, 1], 0 id] +
    Sum[
      epsilon = (-1)^(n + 1 - i - ell);
      -lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
        epsilon (matrixUnit[labels, -i - epsilon, i] -
          matrixUnit[labels, i, -i - epsilon]),
      {i, n - r + 1, n - ell}
    ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareTwistedMinusPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[family === "tB*.1", Join[Range[-n, -1], Range[1, n]], Range[-n, n]];
  lambda = Lookup[params, "Lambda", Switch[family,
    "tB*.1", I q^(n - r),
    "C**.1", I q^(n + 1/2 - r)
  ]];
  mu = Lookup[params, "Mu", Switch[family,
    "tB*.1", q^(-ell - 1),
    "C**.1", If[ell == 0, Symbol["\[Mu]"], q^(-ell - 1)]
  ]];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 - (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    -lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] - matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareSquaredPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, special = "0p", x = u^2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[family === "tC**.1",
    Join[Range[-n, -1], {special}, Range[1, n]],
    Join[Range[-n, -1], {0, special}, Range[1, n]]
  ];
  lambda = Lookup[params, "Lambda", Switch[family,
    "tC**.1", If[r == n, Symbol["\[Lambda]"], I q^(n + 1 - r)],
    "C*.1", q^(n - r + 1/2)
  ]];
  mu = Lookup[params, "Mu", q^(-ell - 1/2)];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  m1 = Sum[
    lambda mu x matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] + matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u^2 - u^-2)/k1[x] (m1 + m2/k2[x]) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

bareTwistedAlternating[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, epsilon, symmetric},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[family === "C**.2", Range[-n, n],
    Join[Range[-n, -1], Range[1, n]]];
  lambda = Lookup[params, "Lambda", Switch[family,
    "B*.2", I q^(n - r),
    "tB*.2", If[MemberQ[{n - 1, n}, r], Symbol["\[Lambda]"],
      I q^(n - r - 1)],
    "C**.2", I q^(n - r - 1/2)
  ]];
  mu = Lookup[params, "Mu", Switch[family,
    "B*.2", If[MemberQ[{0, 1}, ell], Symbol["\[Mu]"], q^(-ell + 1)],
    "tB*.2" | "C**.2", q^-ell
  ]];
  symmetric = MemberQ[{"tB*.2", "C**.2"}, family];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + If[family === "B*.2", -1, 1] (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
      epsilon = (-1)^(n + 1 - i - ell);
      If[symmetric, lambda, -lambda] matrixUnit[labels, -i, -i] +
        lambda^-1 matrixUnit[labels, i, i] +
        epsilon (matrixUnit[labels, -i - epsilon, i] +
          If[symmetric, 1, -1] matrixUnit[labels, i, -i - epsilon]),
      {i, n - r + 1, n - ell}
    ] +
    If[family === "B*.2" && ell == 1,
      -u^-1 (mu - mu^-1) matrixUnit[labels, n, n], 0 id] +
    If[family === "tB*.2" && r == n - 1,
      (lambda + lambda^-1) matrixUnit[labels, 1, 1], 0 id];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareSquaredAlternating[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, epsilon,
   special = "0p", x = u^2},
  If[!MemberQ[{"tC**.2", "C*.2"}, family] || !(0 <= ell <= r <= n),
    Return[$Failed]
  ];
  labels = If[family === "tC**.2",
    Join[Range[-n, -1], {special}, Range[1, n]],
    Join[Range[-n, -1], {0, special}, Range[1, n]]
  ];
  lambda = Lookup[params, "Lambda", If[family === "tC**.2",
    I q^(n - r), q^(n - r - 1/2)]];
  mu = Lookup[params, "Mu", q^(-ell + 1/2)];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 - (mu y)^-1;
  m1 = Sum[
    lambda mu x matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    epsilon = (-1)^(n + 1 - i - ell);
    -lambda matrixUnit[labels, -i, -i] +
      lambda^-1 matrixUnit[labels, i, i] +
      epsilon (matrixUnit[labels, -i - epsilon, i] -
        matrixUnit[labels, i, -i - epsilon]),
    {i, n - r + 1, n - ell}
  ];
  id + (u^2 - u^-2)/k1[x] (m1 + m2/k2[x]) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

bareCD4[family_String, n_Integer, ell_Integer, u_, q_,
    params_Association] := Module[
  {labels, lambda, mu, alpha, id, k1, k2, m1, m2, m2plus,
   m2minus, k2minus, bar},
  If[!MemberQ[{"C.4", "D.4"}, family] ||
      !(0 <= ell <= Floor[n/2]), Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  lambda = Lookup[params, "Lambda", Symbol["\[Lambda]"]];
  alpha = Lookup[params, "Alpha", 1];
  mu = Lookup[params, "Mu", q^(-n + 2 ell) *
    If[family === "D.4" && ell == 1, alpha, 1] lambda];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[matrixUnit[labels, i, i], {i, 1, n}];
  If[family === "D.4" && ell == 1,
    m2plus = u^-1 (mu^-1 matrixUnit[labels, 1, 1] +
      mu matrixUnit[labels, n, n] + matrixUnit[labels, 1, n] +
      matrixUnit[labels, n, 1]);
    k2minus = (alpha lambda)^-1 + alpha (mu u)^-1;
    m2minus = (alpha lambda)^-1 matrixUnit[labels, -1, -1] +
      alpha lambda matrixUnit[labels, -n, -n] +
      matrixUnit[labels, -1, -n] + matrixUnit[labels, -n, -1];
    Return[id + (u - u^-1)/k1 (m1 - m2plus/k2 + m2minus/k2minus)]
  ];
  m2 = Sum[
    bar = n + 1 - i;
    lambda matrixUnit[labels, -i, -i] +
      lambda^-1 matrixUnit[labels, -bar, -bar] +
      matrixUnit[labels, -i, -bar] + matrixUnit[labels, -bar, -i] -
      u^-1 (mu matrixUnit[labels, i, i] +
        mu^-1 matrixUnit[labels, bar, bar] +
        matrixUnit[labels, i, bar] + matrixUnit[labels, bar, i]),
    {i, n - ell + 1, n}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareCStar4[n_Integer, ell_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, bar,
   special = "0p", x = u^2},
  If[!(0 <= ell <= Floor[n/2]), Return[$Failed]];
  labels = Join[Range[-n, -1], {0, special}, Range[1, n]];
  lambda = Lookup[params, "Lambda", Symbol["\[Lambda]"]];
  mu = Lookup[params, "Mu", q^(-n + 2 ell) lambda];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  m1 = Sum[matrixUnit[labels, i, i], {i, 1, n}];
  m2 = lambda^-1 matrixUnit[labels, 0, 0] -
      mu matrixUnit[labels, special, special] +
      I u^-1 (matrixUnit[labels, special, 0] -
        matrixUnit[labels, 0, special]) +
    Sum[
      bar = n + 1 - i;
      lambda matrixUnit[labels, -i, -i] +
        lambda^-1 matrixUnit[labels, -bar, -bar] -
        matrixUnit[labels, -i, -bar] - matrixUnit[labels, -bar, -i] -
        u^-2 (mu matrixUnit[labels, i, i] +
          mu^-1 matrixUnit[labels, bar, bar] -
          matrixUnit[labels, i, bar] - matrixUnit[labels, bar, i]),
      {i, n - ell + 1, n}
    ];
  id + (u^2 - u^-2)/k1[x] (m1 + m2/k2[x]) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

applyDressing[m_?MatrixQ, Identity, _] := m;
applyDressing[m_?MatrixQ, g_?MatrixQ, "Standard"] := Inverse[g].m.g;
applyDressing[m_?MatrixQ, g_?MatrixQ, "Transposed"] := g.m.g;

transportCatalogueResult[d_?SatakeDiagramQ, u_, classification_Association,
    q_, extraParams_Association, dress_, eta_, simplify_, reason_String] := Module[
  {type = d["AffineType"], n = d["Rank"], family, sigma, spectral,
   base, automorphism, g, transported, provenance},
  family = classification["RepresentativeFamily"];
  sigma = If[reason === "DiagramAutomorphism",
    classification["RepresentativePermutation"], d["Tau"]];
  If[!StringQ[family] || !ListQ[sigma],
    Return[Failure["MissingTransportData", classification]]
  ];
  base = KMatrix[<|"Rank" -> n, "Family" -> family,
      "Parameters" -> classification["Parameters"]|>, u,
    "QuantumParameter" -> q, "Parameters" -> extraParams,
    "DressingMatrix" -> Identity];
  If[!AssociationQ[base] || !MatrixQ[base["KMatrix"]],
    Return[Failure["TransportRepresentativeUnavailable", <|
      "Classification" -> classification, "RepresentativeResult" -> base|>]]
  ];
  spectral = Unique["z$transport"];
  automorphism = DiagramAutomorphismIntertwiner[type, n, sigma, spectral, q,
    "SimplifyFunction" -> simplify];
  If[FailureQ[automorphism], Return[automorphism]];
  g = automorphism["Intertwiner"];
  transported = simplify[
    Inverse[g /. spectral -> eta/u].base["KMatrix"].
      (g /. spectral -> eta u)];
  transported = applyDressing[transported, dress, base["Equation"]];
  provenance = Lookup[base, "Provenance", <||>];
  If[!AssociationQ[provenance], provenance = <|"Source" -> provenance|>];
  Join[base, <|"KMatrix" -> transported,
    "Classification" -> classification,
    "Transport" -> <|"Reason" -> reason, "Permutation" -> sigma,
      "Intertwiner" -> g, "ScalingParameter" -> eta|>,
    "Provenance" -> Join[provenance, <|
      "Transport" -> "RepresentationDiagramAutomorphismIntertwiner",
      "TransportPermutation" -> sigma|>]|>]
];

KMatrix::family = "No catalogued closed formula is implemented for family `1`. Supply IntertwinerData or use SolveBoundaryIntertwiner directly.";
KMatrix::params = "Family B*.1 requires integer parameters 0 <= l <= r <= n.";
KMatrix::familyparams = "Family `1` received incompatible or missing classification parameters `2`.";
KMatrix::rank = "Family `1` is not defined at rank n=`2`.";
KMatrix::ambiguous = "The diagram has overlapping candidate families `1`; specify \"Family\" or supply coideal parameters for a derived intertwiner.";
KMatrix::nonquasi = "The diagram is in the non-quasistandard `1` regime. Supply explicit coideal parameters for an intertwiner solve, or request a separately implemented non-quasistandard formula.";
KMatrix::novector = "The classified `1` regime has no vector K-matrix in qRE.";
KMatrix::rotation = "The diagram is classified as `1` only after the diagram automorphism `2`; automatic transport of the closed formula has not been encoded.";
KMatrix::transport = "The diagram belongs to family `1`, but its fork-exchange representative requires a matrix-level transport that has not yet been encoded.";

KMatrix[d_Association, u_, OptionsPattern[]] := Module[
  {method = OptionValue["Method"], family = OptionValue["Family"], params,
   data, result, dress = OptionValue["DressingMatrix"], n, ell, r, cparams, sparams,
   classification = <||>, explicitBoundaryData, catalogueEntry, transported,
   nonQuasiFormula = False, supportedFamilies},
  If[SatakeDiagramQ[d], classification = ClassifySatakeDiagram[d]];
  If[family === Automatic, family = Lookup[d, "Family", Automatic]];
  If[family === Automatic && AssociationQ[classification],
    family = Lookup[classification, "Family", Automatic]
  ];
  params = Join[Lookup[classification, "Parameters", <||>],
    Lookup[d, "Parameters", <||>], OptionValue["Parameters"]];
  If[!StringQ[family] && Lookup[classification, "Regime", None] ===
      "NonQuasistandard",
    supportedFamilies = Select[Lookup[classification, "CandidateFamilies", {}],
      supportedNonQuasiFormulaQ[#, Lookup[d, "Rank", Missing[]],
        Lookup[params, "l", Missing[]], Lookup[params, "r", Missing[]]] &];
    If[Length[supportedFamilies] == 1, family = First[supportedFamilies]]
  ];
  nonQuasiFormula = Lookup[classification, "Regime", None] ===
      "NonQuasistandard" ||
    Lookup[params, "Regime", None] === "NonQuasistandard" ||
    nonQuasiParameterRequestQ[family, Lookup[d, "Rank", Missing[]],
      Lookup[params, "l", Missing[]], Lookup[params, "r", Missing[]], params];
  explicitBoundaryData = OptionValue["CParameters"] =!= Automatic ||
    OptionValue["SParameters"] =!= Automatic || OptionValue["Equation"] =!= Automatic;
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "Regime", None] === "NonQuasistandard",
    n = d["Rank"]; ell = Lookup[params, "l", Missing[]];
    r = Lookup[params, "r", Missing[]];
    If[!supportedNonQuasiFormulaQ[family, n, ell, r],
      Message[KMatrix::nonquasi, Lookup[classification, "RepresentativeFamily", family]];
      Return[Failure["NonQuasistandardFormulaRequired", classification]]
    ]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "Regime", None] === "NoVectorKMatrix",
    Message[KMatrix::novector, Lookup[classification, "RepresentativeFamily", family]];
    Return[Failure["NoVectorKMatrix", classification]]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "ClassificationStatus", None] ===
        "ClassifiedUpToDiagramAutomorphism",
    transported = transportCatalogueResult[d, u, classification,
      OptionValue["QuantumParameter"], OptionValue["Parameters"], dress,
      OptionValue["ScalingParameter"], OptionValue["SimplifyFunction"],
      "DiagramAutomorphism"];
    If[AssociationQ[transported], Return[transported]];
    Message[KMatrix::rotation, Lookup[classification, "RepresentativeFamily", family],
      Lookup[classification, "RepresentativePermutation", Missing[]]];
    Return[Failure["DiagramAutomorphismTransportRequired", <|
      "Classification" -> classification, "Cause" -> transported|>]]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "Regime", None] === "FormulaTransportPending",
    transported = transportCatalogueResult[d, u, classification,
      OptionValue["QuantumParameter"], OptionValue["Parameters"], dress,
      OptionValue["ScalingParameter"], OptionValue["SimplifyFunction"],
      "ForkExchange"];
    If[AssociationQ[transported], Return[transported]];
    Message[KMatrix::transport, Lookup[classification, "RepresentativeFamily", family]];
    Return[Failure["FormulaTransportRequired", <|
      "Classification" -> classification, "Cause" -> transported|>]]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && MissingQ[family] &&
      !TrueQ[explicitBoundaryData] && !KeyExistsQ[d, "IntertwinerData"],
    Message[KMatrix::ambiguous, Lookup[classification, "CandidateFamilies", {}]];
    Return[Failure["AmbiguousKMatrixFamily", classification]]
  ];
  catalogueEntry = If[StringQ[family], Lookup[$catalogue, family, <||>], <||>];
  If[method === Automatic,
    method = Which[
      KeyExistsQ[d, "IntertwinerData"] || explicitBoundaryData, "Intertwiner",
      Lookup[catalogueEntry, "Implementation", None] === "ClosedForm", "Catalogue",
      SatakeDiagramQ[d], "Intertwiner",
      StringQ[family], "Catalogue",
      True, "Catalogue"
    ]
  ];
  Switch[method,
    "Intertwiner",
      data = Lookup[d, "IntertwinerData", Missing["NotAvailable"]];
      If[MissingQ[data],
        If[!SatakeDiagramQ[d], Return[Failure["MissingIntertwinerData", <||>]]];
        cparams = Replace[OptionValue["CParameters"], Automatic :> Lookup[d, "CParameters", <||>]];
        sparams = Replace[OptionValue["SParameters"], Automatic :> Lookup[d, "SParameters", <||>]];
        DeriveKMatrix[d, u, OptionValue["QuantumParameter"], cparams, sparams,
          "ScalingParameter" -> OptionValue["ScalingParameter"],
          "Equation" -> OptionValue["Equation"],
          "NormalizeAt" -> OptionValue["NormalizeAt"],
          "SimplifyFunction" -> OptionValue["SimplifyFunction"]],
        result = SolveBoundaryIntertwiner[data["Left"], data["Right"]];
        If[AssociationQ[result], Append[result, "Provenance" -> "BoundaryIntertwinerSolve"], result]
      ],
    "Catalogue",
      Switch[family,
        "A.1",
          n = Lookup[d, "Rank", Missing["Rank"]];
          If[!IntegerQ[n] || n <= 1, Message[KMatrix::rank, family, n]; Return[$Failed]];
          result = bareA1[n];
          <|"KMatrix" -> applyDressing[result, dress, "Transposed"],
            "Family" -> family, "Equation" -> "Transposed",
            "BasisLabels" -> Range[n + 1], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/resultsA124.tex",
              "Formula" -> "A.1", "ResearchStatus" -> "qREFormula"|>|>,
        "A.2",
          n = Lookup[d, "Rank", Missing["Rank"]];
          result = If[IntegerQ[n], bareA2[n, OptionValue["QuantumParameter"]], $Failed];
          If[result === $Failed, Message[KMatrix::rank, family, n]; Return[$Failed]];
