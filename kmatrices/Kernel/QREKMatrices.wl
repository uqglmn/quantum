BeginPackage["QREKMatrices`"];

QREKMatricesVersion::usage =
  "QREKMatricesVersion[] gives the semantic version of the loaded QREKMatrices paclet.";
TwistedAffineTypes::usage =
  "TwistedAffineTypes[] gives the canonical twisted affine Cartan types supported by the package.";
AffineTypes::usage =
  "AffineTypes[] gives all canonical untwisted and twisted affine Cartan types supported by the package.";
CartanMatrixOf::usage =
  "CartanMatrixOf[type, n] gives the rank n+1 generalized Cartan matrix in the qRE_II node convention 0,...,n.";
SymmetrizersOf::usage =
  "SymmetrizersOf[type, n] gives the tuple d_i for which d_i a_ij is symmetric in the qRE/qRE_II conventions.";
CreateSatakeDiagram::usage =
  "CreateSatakeDiagram[type, n, X, tau] constructs and validates a generalized Satake diagram. tau is a zero-based image list or an Association; its default is the identity.";
GeneralizedSatakeDiagrams::usage =
  "GeneralizedSatakeDiagrams[type, n] enumerates all generalized Satake diagrams for a supported untwisted or twisted affine Cartan matrix at fixed rank.";
SatakeDiagramQ::usage =
  "SatakeDiagramQ[diagram] returns True when diagram is a structurally valid qRE diagram Association.";
SatakeDiagramData::usage =
  "SatakeDiagramData[diagram] gives all stored and derived data; SatakeDiagramData[diagram, key] extracts one item.";
ClassifySatakeDiagram::usage =
  "ClassifySatakeDiagram[diagram] identifies the qRE/qRE_II family and classification parameters when the family classifier is implemented.";
BoundaryEquationType::usage =
  "BoundaryEquationType[diagram] gives \"Standard\" or \"Transposed\" according to the qRE vector-representation existence criterion.";
CanonicalCoidealParameters::usage =
  "CanonicalCoidealParameters[diagram, q] gives the bare c, s, and scaling assignments when they have been encoded for the classified diagram family.";
LongestParabolicElement::usage =
  "LongestParabolicElement[A, X] gives the root-lattice matrix of the longest element of the finite parabolic Weyl group generated by zero-based nodes X.";
LongestParabolicWord::usage =
  "LongestParabolicWord[A, X] gives a reduced zero-based simple-reflection word for the longest element of the finite parabolic subsystem on X.";
SolveBoundaryIntertwiner::usage =
  "SolveBoundaryIntertwiner[left, right] solves K.left[[i]] == right[[i]].K simultaneously and returns an Association containing a basis and generic K-matrix.";
VerifyBoundaryIntertwiner::usage =
  "VerifyBoundaryIntertwiner[K, left, right] checks K.left[[i]] == right[[i]].K for every generator.";
KMatrix::usage =
  "KMatrix[diagram, u] returns a catalogued K-matrix or derives one from a generalized Satake diagram and represented boundary intertwining equations.";
KMatrixCandidates::usage =
  "KMatrixCandidates[diagram, u] returns one named catalogue result for every family compatible with an ambiguous generalized Satake diagram, without choosing between the coideal regimes.";
KMatrixTable::usage =
  "KMatrixTable[type, n, u] enumerates every generalized Satake diagram of the given affine type and returns its classification, computation status, and K-matrix result.";
KMatrixCatalogue::usage =
  "KMatrixCatalogue[] reports the implementation and research status of qRE and qRE_II families.";
KMatrixFamilies::usage =
  "KMatrixFamilies[type] gives the registered K-matrix family identifiers for a supported affine presentation.";
KMatrixFamilyData::usage =
  "KMatrixFamilyData[family] gives structured family metadata, parameter domains, general formula data, properties, and source anchors.";
KMatrixRealizationData::usage =
  "KMatrixRealizationData[diagram, u] gives a bare, dressed, or transported K-matrix realization with an explicit transformation chain.";
KMatrixPropertyData::usage =
  "KMatrixPropertyData[result, u] gives structured eigenvalue, polynomial-identity, determinant, factorization, regularity, and unitarity records for a K-matrix realization.";
VectorRepresentation::usage =
  "VectorRepresentation[type, n, z, q] gives the vector evaluation representation as an Association containing E, F, K, KInverse, basis labels, and Cartan data.";
DualVectorRepresentation::usage =
  "DualVectorRepresentation[rep] gives the representation a |-> Transpose[rep[S(a)]] used by the transposed boundary intertwining equation.";
VerifyVectorRepresentation::usage =
  "VerifyVectorRepresentation[rep] checks the Chevalley and quantum Serre relations represented by a VectorRepresentation result.";
BraidOperator::usage =
  "BraidOperator[rep, i] gives a matrix implementing Lusztig's T''_{i,1} on a vector representation by conjugation.";
DiagramAutomorphismIntertwiner::usage =
  "DiagramAutomorphismIntertwiner[type, n, sigma, z, q] derives the matrix G_sigma(z) implementing a zero-based affine Dynkin diagram automorphism in the vector evaluation representation.";
RepresentedQPGenerators::usage =
  "RepresentedQPGenerators[diagram, z, q, c, s] constructs the represented generators of B_{c,s}(X,tau) at spectral parameter z.";
DeriveKMatrix::usage =
  "DeriveKMatrix[diagram, u, q, c, s] constructs QP generators at u and 1/u and solves their boundary intertwining equations.";
VerifyKMatrix::usage =
  "VerifyKMatrix[K, diagram, u, q, c, s] verifies a matrix against the represented standard or antipode--transpose boundary equation.";
InferCoidealParameters::usage =
  "InferCoidealParameters[K, diagram, u, q] solves the represented boundary equations for coideal parameters c_i and admissible s_i compatible with K.";
QSPPresentationData::usage =
  "QSPPresentationData[diagram] gives a structured, convention-labelled presentation of the quantum symmetric pair algebra attached to a generalized Satake diagram.";
AmbientRMatrixData::usage =
  "AmbientRMatrixData[type, n] gives the registered vector representation and explicit operator formula for its normalized ambient trigonometric R-matrix.";
AmbientRMatrix::usage =
  "AmbientRMatrix[type, n, u, q] materializes the normalized ambient trigonometric R-matrix as a sparse matrix in the lexicographic tensor-product basis.";
ReflectionEquationResidual::usage =
  "ReflectionEquationResidual[K, diagram, {u, v}, q] gives the tensor-matrix residual of the standard or transposed reflection equation, regarding K as an expression in u.";
VerifyReflectionEquation::usage =
  "VerifyReflectionEquation[K, diagram, {u, v}, q] checks that the corresponding reflection-equation residual vanishes.";
ReflectionEquationCertificate::usage =
  "ReflectionEquationCertificate[K, diagram, {u, v}, q] returns a structured exact verification certificate with conventions, method, and residual diagnostics.";
ReflectionEquationData::usage =
  "ReflectionEquationData[diagram, rMatrixId] gives the convention-labelled reflection equation associated to a generalized Satake diagram.";
WebExpressionData::usage =
  "WebExpressionData[expr] converts an evaluated Wolfram expression to the safe versioned expression tree used by the web catalogue.";
WebCatalogueData::usage =
  "WebCatalogueData[type, n] gives a JSON-compatible web catalogue for all generalized Satake diagrams of the specified affine type and rank.";
ExportWebCatalogue::usage =
  "ExportWebCatalogue[path] exports a manifest and one JSON catalogue per requested affine type and rank.";

Begin["`Private`"];

$untwistedTypes = {"A(1)", "B(1)", "C(1)", "D(1)"};
$twistedTypes = {
  "A2n-1(2)", "A2n-1(2)T", "A2n(2)", "A2n(2)T", "Dn+1(2)"
};
$canonicalTypes = Join[$untwistedTypes, $twistedTypes];
$qreKMatricesVersion = "0.20.0";
$webCatalogueSchemaVersion = "1.7.0";

QREKMatricesVersion[] := $qreKMatricesVersion;

$typeAliases = <|
  "A(1)" -> "A(1)", "A_n^(1)" -> "A(1)", "A_n^{(1)}" -> "A(1)", "A" -> "A(1)",
  "B(1)" -> "B(1)", "B_n^(1)" -> "B(1)", "B_n^{(1)}" -> "B(1)", "B" -> "B(1)",
  "C(1)" -> "C(1)", "C_n^(1)" -> "C(1)", "C_n^{(1)}" -> "C(1)", "C" -> "C(1)",
  "D(1)" -> "D(1)", "D_n^(1)" -> "D(1)", "D_n^{(1)}" -> "D(1)", "D" -> "D(1)",
  "A2n-1(2)" -> "A2n-1(2)", "A_{2n-1}^{(2)}" -> "A2n-1(2)",
  "B*" -> "A2n-1(2)", "DC" -> "A2n-1(2)",
  "A2n-1(2)T" -> "A2n-1(2)T", "A_{2n-1}^{(2)T}" -> "A2n-1(2)T",
  "tB*" -> "A2n-1(2)T", "CD" -> "A2n-1(2)T",
  "A2n(2)" -> "A2n(2)", "A_{2n}^{(2)}" -> "A2n(2)",
  "C**" -> "A2n(2)", "CB" -> "A2n(2)",
  "A2n(2)T" -> "A2n(2)T", "A_{2n}^{(2)T}" -> "A2n(2)T",
  "tC**" -> "A2n(2)T", "BC" -> "A2n(2)T",
  "Dn+1(2)" -> "Dn+1(2)", "D_{n+1}^{(2)}" -> "Dn+1(2)",
  "C*" -> "Dn+1(2)", "BB" -> "Dn+1(2)"
|>;

canonicalType[type_String] := Lookup[$typeAliases, type, Missing["UnknownType", type]];
canonicalType[type_] := Missing["UnknownType", type];

TwistedAffineTypes[] := $twistedTypes;
AffineTypes[] := $canonicalTypes;

(* Structured K-matrix family content ------------------------------------- *)

familyASTInteger[value_Integer] := <|"kind" -> "integer",
  "value" -> ToString[value, InputForm]|>;
familyASTRational[numerator_Integer, denominator_Integer] := <|
  "kind" -> "rational", "numerator" -> ToString[numerator, InputForm],
  "denominator" -> ToString[denominator, InputForm]|>;
familyASTSymbol[name_String] := <|"kind" -> "symbol", "name" -> name|>;
familyASTCall[head_String, arguments_List] := <|"kind" -> "call",
  "head" -> head, "arguments" -> arguments|>;
familyASTFunction[name_String, arguments___] :=
  familyASTCall[name, {arguments}];
familyASTTimes[arguments___] := familyASTCall["Times", {arguments}];
familyASTPlus[arguments___] := familyASTCall["Plus", {arguments}];
familyASTPower[base_, exponent_Integer] := familyASTCall["Power",
  {base, familyASTInteger[exponent]}];
familyASTDivide[numerator_, denominator_] := familyASTTimes[numerator,
  familyASTPower[denominator, -1]];
familyASTEqual[left_, right_] := familyASTCall["Equal", {left, right}];

familySource[source_String, anchor_String, role_String : "formula"] := <|
  "Source" -> source, "Anchor" -> anchor, "Role" -> role|>;
familyConstraint[id_String, kind_String, latex_String] := <|
  "ConstraintID" -> id, "Kind" -> kind, "LaTeX" -> latex|>;
familyParameter[name_String, label_String] := <|
  "Name" -> name, "Label" -> label, "Type" -> "integer"|>;

$familyMasterFormulaAST := With[
  {u = familyASTSymbol["u"], k = familyASTFunction["K", familyASTSymbol["u"]],
   identity = familyASTSymbol["Id"]},
  familyASTEqual[k, familyASTPlus[identity,
    familyASTTimes[
      familyASTDivide[
        familyASTPlus[u, familyASTTimes[familyASTInteger[-1],
          familyASTPower[u, -1]]],
        familyASTFunction["k1", u]],
      familyASTPlus[familyASTFunction["M1", u],
        familyASTDivide[familyASTFunction["M2", u],
          familyASTFunction["k2", u]]]]]]
];

familyFormula[kind_String, latex_String, expression_Association,
    definitions_List, assumptions_String, sources_List] := <|
  "Kind" -> kind, "Status" -> "published", "LaTeX" -> latex,
  "Expression" -> expression, "Definitions" -> definitions,
  "AssumptionsLaTeX" -> assumptions, "SourceAnchors" -> sources|>;
familyDefinition[id_String, label_String, latex_String,
    expression_Association] := <|"DefinitionID" -> id,
  "Label" -> label, "LaTeX" -> latex, "Expression" -> expression|>;

$a1Formula = familyFormula["identity",
  "K(u)=\\operatorname{Id}",
  familyASTEqual[familyASTFunction["K", familyASTSymbol["u"]],
    familyASTSymbol["Id"]], {}, "N>2",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsA124.tex", "sec:K:tw", "derivation"]}];

$a2Formula = familyFormula["constantBlockSum",
  "K(u)=\\sum_{1\\leq i\\leq N/2}\\left(q^{1/2}E_{2i-1,2i}-q^{-1/2}E_{2i,2i-1}\\right)",
  familyASTEqual[familyASTFunction["K", familyASTSymbol["u"]],
    familyASTFunction["Sum",
      familyASTPlus[
        familyASTTimes[familyASTCall["Power", {familyASTSymbol["q"],
            familyASTRational[1, 2]}],
          familyASTFunction["MatrixUnit", familyASTSymbol["2i-1"],
            familyASTSymbol["2i"]]],
        familyASTTimes[familyASTInteger[-1],
          familyASTCall["Power", {familyASTSymbol["q"],
            familyASTRational[-1, 2]}],
          familyASTFunction["MatrixUnit", familyASTSymbol["2i"],
            familyASTSymbol["2i-1"]]]],
      familyASTSymbol["i=1..N/2"]]], {}, "N>2\\text{ even}",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsA124.tex", "sec:K:tw", "derivation"]}];

$a3Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1(u)+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["a3-k1", "First denominator",
     "k_1(u)=\\lambda\\mu-u",
     familyASTEqual[familyASTFunction["k1", familyASTSymbol["u"]],
       familyASTPlus[familyASTTimes[familyASTSymbol["lambda"],
         familyASTSymbol["mu"]], familyASTTimes[familyASTInteger[-1],
         familyASTSymbol["u"]]]]],
   familyDefinition["a3-k2", "Second denominator",
     "k_2(u)=\\lambda^{-1}+(\\mu u)^{-1}",
     familyASTEqual[familyASTFunction["k2", familyASTSymbol["u"]],
       familyASTPlus[familyASTPower[familyASTSymbol["lambda"], -1],
         familyASTPower[familyASTTimes[familyASTSymbol["mu"],
           familyASTSymbol["u"]], -1]]]],
   familyDefinition["a3-m1", "Diagonal term",
     "M_1(u)=\\sum_{1\\leq i\\leq\\ell}\\lambda\\mu uE_{ii}+\\sum_{t-\\ell<i\\leq N}E_{ii}",
     familyASTFunction["A3M1", familyASTSymbol["u"],
       familyASTSymbol["N"], familyASTSymbol["l"],
       familyASTSymbol["t"]]],
   familyDefinition["a3-m2", "Paired term",
     "M_2(u)=\\sum_{\\ell<i\\leq r}\\left(\\lambda E_{ii}+\\lambda^{-1}E_{t+1-i,t+1-i}+E_{i,t+1-i}+E_{t+1-i,i}\\right)",
     familyASTFunction["A3M2", familyASTSymbol["u"],
       familyASTSymbol["N"], familyASTSymbol["l"],
       familyASTSymbol["r"], familyASTSymbol["t"]]]},
  "0\\leq\\ell\\leq r\\leq\\lfloor t/2\\rfloor",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsA3.tex", "Res:A3", "specialization"]}];

$a4Formula = familyFormula["halfPeriodExchange",
  "K(u)=\\sum_{1\\leq i\\leq N/2}\\left(uE_{i+N/2,i}+E_{i,i+N/2}\\right)",
  familyASTEqual[familyASTFunction["K", familyASTSymbol["u"]],
    familyASTFunction["Sum",
      familyASTPlus[
        familyASTTimes[familyASTSymbol["u"],
          familyASTFunction["MatrixUnit", familyASTSymbol["i+N/2"],
            familyASTSymbol["i"]]],
        familyASTFunction["MatrixUnit", familyASTSymbol["i"],
          familyASTSymbol["i+N/2"]]],
      familyASTSymbol["i=1..N/2"]]], {}, "N>2\\text{ even}",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsA124.tex", "sec:K:tw", "derivation"]}];

$b1Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1(u)+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["b1-denominators", "Denominators",
     "k_1(u)=\\lambda\\mu-u,\\qquad k_2(u)=\\lambda^{-1}+(\\mu u)^{-1}",
     familyASTFunction["Definitions", familyASTSymbol["k1"],
       familyASTSymbol["k2"]]],
   familyDefinition["b1-m1", "Diagonal term",
     "M_1(u)=\\sum_{\\bar\\ell\\leq i\\leq n}(\\lambda\\mu uE_{-i,-i}+E_{ii})",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M1"],
       familyASTSymbol["bar(l)<=i<=n"]]],
   familyDefinition["b1-m2", "Exchange term",
     "M_2(u)=\\sum_{\\bar r\\leq i<\\bar\\ell}(\\lambda E_{-i,-i}+\\lambda^{-1}E_{ii}+E_{-i,i}+E_{i,-i})",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M2"],
       familyASTSymbol["bar(r)<=i<bar(l)"]]],
   familyDefinition["b1-parameters", "Parameters",
     "N=2n+1,\\qquad\\lambda=q^{N/2-r},\\qquad\\mu=q^{-\\ell}",
     familyASTFunction["ParameterSpecialization", familyASTSymbol["lambda"],
       familyASTSymbol["mu"]]]},
  "0\\leq\\ell\\leq r\\leq n",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsBD1C2.tex", "res:BD1", "specialization"]}];

$b2Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1(u)+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["b2-denominators", "Denominators",
     "k_1(u)=\\lambda\\mu-u,\\qquad k_2(u)=\\lambda^{-1}-(\\mu u)^{-1}",
     familyASTFunction["Definitions", familyASTSymbol["k1"],
       familyASTSymbol["k2"]]],
   familyDefinition["b2-m1", "Diagonal term",
     "M_1(u)=\\sum_{\\bar\\ell\\leq i\\leq n}(\\lambda\\mu uE_{-i,-i}+E_{ii})",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M1"],
       familyASTSymbol["bar(l)<=i<=n"]]],
   familyDefinition["b2-m2", "Alternating term",
     "M_2(u)=-\\delta_{\\ell,1}u^{-1}(\\mu-\\mu^{-1})E_{nn}+\\sum_{\\bar r\\leq i<\\bar\\ell}(-\\lambda E_{-i,-i}+\\lambda^{-1}E_{ii}+\\varepsilon_i(E_{-i-\\varepsilon_i,i}-E_{i,-i-\\varepsilon_i}))",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M2"],
       familyASTSymbol["bar(r)<=i<bar(l)"]]],
   familyDefinition["b2-parameters", "Parameters",
     "N=2n+1,\\quad\\lambda=q^{N/2-r-1},\\quad\\mu=q^{-\\ell+1};\\qquad\\mu\\in\\mathbb K^\\times\\ (\\ell\\in\\{0,1\\})",
     familyASTFunction["ParameterSpecialization", familyASTSymbol["lambda"],
       familyASTSymbol["mu"], familyASTSymbol["epsilon_i"]]]},
  "0\\leq\\ell\\leq r\\leq n",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsC1BD2.tex", "D2:K", "specialization"]}];

$c1Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1(u)+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["c1-denominators", "Denominators",
     "k_1(u)=\\lambda\\mu-u,\\qquad k_2(u)=\\lambda^{-1}-(\\mu u)^{-1}",
     familyASTFunction["Definitions", familyASTSymbol["k1"],
       familyASTSymbol["k2"]]],
   familyDefinition["c1-m1", "Diagonal term",
     "M_1(u)=\\sum_{\\bar\\ell\\leq i\\leq n}(\\lambda\\mu uE_{-i,-i}+E_{ii})",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M1"],
       familyASTSymbol["bar(l)<=i<=n"]]],
   familyDefinition["c1-m2", "Off-diagonal term",
     "M_2(u)=\\sum_{\\bar r\\leq i<\\bar\\ell}(-\\lambda E_{-i,-i}+\\lambda^{-1}E_{ii}+E_{-i,i}-E_{i,-i})",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M2"],
       familyASTSymbol["bar(r)<=i<bar(l)"]]],
   familyDefinition["c1-parameters", "Parameters",
     "\\lambda=q^{\\bar r},\\quad\\mu=q^{-\\ell-1};\\qquad\\mu\\in\\mathbb K^\\times\\ (\\ell=0),\\quad\\lambda\\in\\mathbb K^\\times\\ (r=n)",
     familyASTFunction["ParameterSpecialization", familyASTSymbol["lambda"],
       familyASTSymbol["mu"]]]},
  "0\\leq\\ell\\leq r\\leq n",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsC1BD2.tex", "Res:C1", "specialization"]}];

$c2Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1(u)+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["c2-denominators", "Denominators",
     "k_1(u)=\\lambda\\mu-u,\\qquad k_2(u)=\\lambda^{-1}+(\\mu u)^{-1}",
     familyASTFunction["Definitions", familyASTSymbol["k1"],
       familyASTSymbol["k2"]]],
   familyDefinition["c2-m1", "Diagonal term",
     "M_1(u)=\\sum_{\\bar\\ell\\leq i\\leq n}(\\lambda\\mu uE_{-i,-i}+E_{ii})",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M1"],
       familyASTSymbol["bar(l)<=i<=n"]]],
   familyDefinition["c2-m2", "Alternating term",
     "M_2(u)=\\sum_{\\bar r\\leq i<\\bar\\ell}(\\lambda E_{-i,-i}+\\lambda^{-1}E_{ii}+\\varepsilon_i(E_{i,-i-\\varepsilon_i}+E_{-i-\\varepsilon_i,i}))",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M2"],
       familyASTSymbol["bar(r)<=i<bar(l)"]]],
   familyDefinition["c2-parameters", "Parameters",
     "\\lambda=q^{n-r},\\quad\\mu=q^{-\\ell},\\quad\\varepsilon_i=(-1)^{i+n+1-\\ell}",
     familyASTFunction["ParameterSpecialization", familyASTSymbol["lambda"],
       familyASTSymbol["mu"], familyASTSymbol["epsilon_i"]]]},
  "0\\leq\\ell\\leq r\\leq n,\\qquad r-\\ell\\text{ even}",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsBD1C2.tex", "Res:C2", "specialization"]}];

$c4Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["c4-denominators", "Denominators",
     "k_1(u)=\\lambda\\mu-u,\\qquad k_2(u)=\\lambda^{-1}+(\\mu u)^{-1}",
     familyASTFunction["Definitions", familyASTSymbol["k1"],
       familyASTSymbol["k2"]]],
   familyDefinition["c4-m1", "Positive diagonal term",
     "M_1=\\sum_{1\\leq i\\leq n}E_{ii}",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M1"],
       familyASTSymbol["1<=i<=n"]]],
   familyDefinition["c4-m2", "Paired term",
     "M_2(u)=\\sum_{\\bar\\ell\\leq i\\leq n}(\\lambda E_{-i,-i}+\\lambda^{-1}E_{-\\bar\\imath,-\\bar\\imath}+E_{-i,-\\bar\\imath}+E_{-\\bar\\imath,-i}-u^{-1}(\\mu E_{ii}+\\mu^{-1}E_{\\bar\\imath,\\bar\\imath}+E_{i,\\bar\\imath}+E_{\\bar\\imath,i}))",
     familyASTFunction["IndexedMatrixSum", familyASTSymbol["M2"],
       familyASTSymbol["bar(l)<=i<=n"]]],
   familyDefinition["c4-parameters", "Parameters",
     "\\lambda\\in\\mathbb K^\\times,\\qquad\\mu=q^{-n+2\\ell}\\lambda",
     familyASTFunction["ParameterSpecialization", familyASTSymbol["lambda"],
       familyASTSymbol["mu"]]]},
  "0\\leq\\ell\\leq\\lfloor n/2\\rfloor",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsCD4.tex", "Res:CD4", "specialization"]}];

$d1Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1(u)+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["d1-denominators", "Denominators",
     "k_1(u)=\\lambda\\mu-u,\\qquad k_2(u)=\\lambda^{-1}+(\\mu u)^{-1}",
     familyASTFunction["Definitions", familyASTSymbol["k1"],
       familyASTSymbol["k2"]]],
   familyDefinition["d1-terms", "Family terms",
     "M_1(u)\\text{ is the BCD.12 diagonal term and }M_2(u)=\\sum_{\\bar r\\leq i<\\bar\\ell}(\\lambda E_{-i,-i}+\\lambda^{-1}E_{ii}+E_{-i,i}+E_{i,-i})",
     familyASTFunction["IndexedMatrixSums", familyASTSymbol["M1"],
       familyASTSymbol["M2"]]],
   familyDefinition["d1-parameters", "Parameters",
     "N=2n,\\qquad\\lambda=q^{n-r},\\qquad\\mu=q^{-\\ell}",
     familyASTFunction["ParameterSpecialization", familyASTSymbol["lambda"],
       familyASTSymbol["mu"]]]},
  "0\\leq\\ell\\leq r\\leq n",
  {familySource["qRE/files/results.tex", "T:all-K"],
   familySource["qRE/files/resultsBD1C2.tex", "res:BD1", "specialization"]}];

$d2Formula = familyFormula["masterFormula",
  "K(u)=\\operatorname{Id}+\\frac{u-u^{-1}}{k_1(u)}\\left(M_1(u)+\\frac{M_2(u)}{k_2(u)}\\right)",
  $familyMasterFormulaAST,
  {familyDefinition["d2-denominators", "Denominators",
     "k_1(u)=\\lambda\\mu-u,\\qquad k_2(u)=\\lambda^{-1}-(\\mu u)^{-1}",
