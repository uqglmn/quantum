Options[KMatrix] = {
  "Method" -> Automatic,
  "Family" -> Automatic,
  "Parameters" -> <||>,
  "DressingMatrix" -> Identity,
  "QuantumParameter" -> q,
  "CParameters" -> Automatic,
  "SParameters" -> Automatic,
  "ScalingParameter" -> 1,
  "Equation" -> Automatic,
  "NormalizeAt" -> None,
  "SimplifyFunction" -> Together
};

bareBDC1[n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {lambda, mu, labels, id, k1, k2, block1, block2},
  lambda = Lookup[params, "Lambda", If[r == n,
    Symbol["\[Lambda]"], I q^(n - r + 1)]];
  mu = Lookup[params, "Mu", q^-ell];
  labels = Join[Range[-n, -1], Range[1, n]];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  block1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  block2 = Sum[
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] + matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (block1 + block2/k2)
];

bareNonQuasiPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, id, lambda, mu, nu, k1, k2, bar, a, b, c, d, m1, m2, m3,
   maxEll},
  maxEll = If[family === "C**.1", n - 2, n - 3];
  If[!MemberQ[{"B*.1", "tB*.1", "C**.1"}, family] || r =!= ell + 2 ||
      !(1 <= ell <= maxEll), Return[$Failed]];
  labels = If[family === "C**.1", Range[-n, n],
    Join[Range[-n, -1], Range[1, n]]];
  id = IdentityMatrix[Length[labels], SparseArray];
  lambda = Lookup[params, "Lambda", Switch[family,
    "B*.1", I q^(n - r + 1),
    "tB*.1", I q^(n - r),
    "C**.1", I q^(n + 1/2 - r)
  ]];
  mu = Lookup[params, "Mu", If[family === "B*.1", q^-ell, q^(-ell - 1)]];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 + If[family === "B*.1", 1, -1] (mu x)^-1;
  bar = n + 1 - ell;
  {a, b, c, d} = {2 - bar, bar - 2, 1 - bar, bar - 1};
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, bar - 1, n}
  ];
  If[family === "B*.1",
    m2 = lambda matrixUnit[labels, a, a] +
      lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] +
      matrixUnit[labels, b, a] - mu u matrixUnit[labels, c, c] -
      (mu u)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] +
      matrixUnit[labels, d, c];
    m3 = matrixUnit[labels, c, a] - matrixUnit[labels, a, c] +
      lambda^-1 (matrixUnit[labels, c, b] - matrixUnit[labels, b, c]) +
      (mu u)^-1 (matrixUnit[labels, a, d] - matrixUnit[labels, d, a] +
        lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b])),
    m2 = -lambda matrixUnit[labels, a, a] +
      lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] -
      matrixUnit[labels, b, a] - mu u matrixUnit[labels, c, c] +
      (mu u)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] -
      matrixUnit[labels, d, c];
    m3 = -matrixUnit[labels, c, a] + matrixUnit[labels, a, c] +
      lambda^-1 (matrixUnit[labels, c, b] + matrixUnit[labels, b, c]) -
      (mu u)^-1 (matrixUnit[labels, a, d] + matrixUnit[labels, d, a] +
        lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b]))
  ];
  id + (u - u^-1)/k1[u] (m1 +
    (k2[u] m2 + (nu + nu^-1) m3)/
      (k2[-nu^-2 u] k2[-nu^2 u]))
];

bareNonQuasiBEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, id, lambda, mu = 1, nu0, nu1, k1, k2, alpha, m2,
   m3minus, m3plus, denominator},
  If[{ell, r} =!= {0, 2} || n < 2, Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  id = IdentityMatrix[2 n, SparseArray];
  lambda = Lookup[params, "Lambda", I q^(n - 1)];
  nu0 = Lookup[params, "Nu0", Symbol["\[Nu]0"]];
  nu1 = Lookup[params, "Nu1", Symbol["\[Nu]1"]];
  k1[x_] := lambda mu - x;
  k2[x_] := lambda^-1 + (mu x)^-1;
  alpha[x_] := (nu1 + nu1^-1) x - (nu0 + nu0^-1);
  m2 = Sum[
    lambda matrixUnit[labels, -i, -i] +
      lambda^-1 matrixUnit[labels, i, i] + matrixUnit[labels, -i, i] +
      matrixUnit[labels, i, -i], {i, n - 1, n}];
  m3minus = matrixUnit[labels, -n, n - 1] -
      matrixUnit[labels, n - 1, -n] +
    lambda (matrixUnit[labels, -n, 1 - n] -
      matrixUnit[labels, 1 - n, -n] +
      (nu1 + nu1^-1) matrixUnit[labels, -n, -n]);
  m3plus = matrixUnit[labels, n, 1 - n] -
      matrixUnit[labels, 1 - n, n] +
    lambda^-1 (matrixUnit[labels, n, n - 1] -
      matrixUnit[labels, n - 1, n] -
      (nu1 + nu1^-1) matrixUnit[labels, n, n]);
  denominator = k1[nu0 u/nu1] k1[nu1 u/nu0]
    k1[nu0 nu1 u] k1[u/(nu0 nu1)];
  id + (u - u^-1) lambda^2 u^2/denominator *
    (k1[u] k2[u] m2 + alpha[u/lambda] m3minus +
      alpha[lambda/u] m3plus)
];

bareNonQuasiCMinusEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, id, lambda, mu, nu, k1, k2, m1, m2, m3, denominator},
  If[{ell, r} =!= {n - 1, n} || n < 2, Return[$Failed]];
  labels = Range[-n, n];
  id = IdentityMatrix[2 n + 1, SparseArray];
  lambda = Lookup[params, "Lambda", I q^(1/2)];
  mu = Lookup[params, "Mu", q^-n];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[x_] := lambda mu - x;
  (* This endpoint is written in the source convention
     k2(x)=lambda^-1+(mu x)^-1; the main C**.1 implementation absorbs
     the displayed argument -x into its local definition instead. *)
  k2[x_] := lambda^-1 + (mu x)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] +
      matrixUnit[labels, i, i], {i, 1, n}];
  m2 = -mu u matrixUnit[labels, -1, -1] +
    (mu u)^-1 matrixUnit[labels, 1, 1] +
    matrixUnit[labels, -1, 1] - matrixUnit[labels, 1, -1];
  m3 = (-1)^(1/4) k1[u^-1] (
      u^-1 (matrixUnit[labels, 0, 1] -
        I matrixUnit[labels, 1, 0]) -
      mu (matrixUnit[labels, 0, -1] +
        I matrixUnit[labels, -1, 0])) +
    (* KCB1xx in the verification notebook has nu+nu^-1 here; the
       surviving minus sign in nqs_temp.tex is a manuscript typo. *)
    Sqrt[1 + q] (nu + nu^-1) mu u^-1 matrixUnit[labels, 0, 0];
  denominator = k1[-nu^-2 u^-1] k1[-nu^2 u^-1] k2[-u];
  id + (u - u^-1)/k1[u] (m1 +
    (k1[u^-1]^2 m2 + Sqrt[1 + q] (nu + nu^-1) m3)/
      denominator)
];

bareNonQuasiTCMinusEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, special = "0p", id, lambda, mu, nu, x = u^2, k1, k2,
   h1, m1, m3, denominator},
  If[{ell, r} =!= {0, 1} || n < 2, Return[$Failed]];
  labels = Join[Range[-n, -1], {special}, Range[1, n]];
  id = IdentityMatrix[2 n + 1, SparseArray];
  lambda = Lookup[params, "Lambda", I q^n];
  mu = Lookup[params, "Mu", q^(-1/2)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  h1[y_] := k1[y^-1]/k1[y];
  m1 = lambda matrixUnit[labels, -n, -n] +
    lambda^-1 matrixUnit[labels, n, n] +
    matrixUnit[labels, -n, n] + matrixUnit[labels, n, -n];
  m3 = mu u (matrixUnit[labels, n, special] -
      matrixUnit[labels, special, n] +
      lambda (matrixUnit[labels, -n, special] -
        matrixUnit[labels, special, -n]) -
      u Sqrt[1 + q] (nu + nu^-1) mu lambda/k1[x] *
        matrixUnit[labels, special, special]);
  denominator = k1[-nu^-2 x] k1[-nu^2 x] k2[x];
  id + (x - x^-1) (k1[x] m1 +
      Sqrt[1 + q] (nu + nu^-1) m3)/denominator +
    (x h1[x] - 1) matrixUnit[labels, special, special]
];

bareNonQuasiCStarEndpoint[n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, special = "0p", id, lambda, mu, nu, x = u^2, k1, k2,
   h1, m2, offDiagonal, numerator, denominator},
  If[{ell, r} =!= {0, 1} || n < 2, Return[$Failed]];
  labels = Join[Range[-n, -1], {0, special}, Range[1, n]];
  id = IdentityMatrix[2 n + 2, SparseArray];
  lambda = Lookup[params, "Lambda", q^(n - 1/2)];
  mu = Lookup[params, "Mu", q^(-1/2)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  h1[y_] := k1[y^-1]/k1[y];
  m2 = lambda matrixUnit[labels, -n, -n] +
    lambda^-1 matrixUnit[labels, n, n] +
    matrixUnit[labels, -n, n] + matrixUnit[labels, n, -n];
  offDiagonal = matrixUnit[labels, special, n] -
    matrixUnit[labels, n, special] -
    lambda matrixUnit[labels, -n, special] +
    lambda matrixUnit[labels, special, -n];
  (* KBB1xx separates the 0' diagonal term from M3.  The typeset draft
     accidentally places it inside M3, introducing extra powers of
     Sqrt[1+q] and nu+nu^-1. *)
  numerator = k1[x] m2 +
    Sqrt[1 + q] (nu + nu^-1) mu u offDiagonal -
    lambda mu u^2/k1[x] (mu + mu^-1) (nu + nu^-1)^2 *
      matrixUnit[labels, special, special];
  denominator = k1[-nu^2 x] k1[-nu^-2 x] k2[x];
  id + (x - x^-1) numerator/denominator +
    (x h1[x] - 1) matrixUnit[labels, special, special]
];

bareNonQuasiSquaredPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, special = "0p", id, lambda, mu, nu, x = u^2, k1, k2,
   bar, a, b, c, d, m1, m2, m3},
  If[!MemberQ[{"tC**.1", "C*.1"}, family] ||
      !supportedNonQuasiFormulaQ[family, n, ell, r], Return[$Failed]];
  labels = If[family === "tC**.1",
    Join[Range[-n, -1], {special}, Range[1, n]],
    Join[Range[-n, -1], {0, special}, Range[1, n]]];
  id = IdentityMatrix[Length[labels], SparseArray];
  lambda = Lookup[params, "Lambda", If[family === "tC**.1",
    I q^(n + 1 - r), q^(n - r + 1/2)]];
  mu = Lookup[params, "Mu", q^(-ell - 1/2)];
  nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  bar = n + 1 - ell;
  {a, b, c, d} = {2 - bar, bar - 2, 1 - bar, bar - 1};
  m1 = Sum[
    lambda mu x matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, bar - 1, n}
  ];
  m2 = lambda matrixUnit[labels, a, a] +
    lambda^-1 matrixUnit[labels, b, b] + matrixUnit[labels, a, b] +
    matrixUnit[labels, b, a] - mu x matrixUnit[labels, c, c] -
    (mu x)^-1 matrixUnit[labels, d, d] + matrixUnit[labels, c, d] +
    matrixUnit[labels, d, c];
  m3 = matrixUnit[labels, c, a] - matrixUnit[labels, a, c] +
    lambda^-1 (matrixUnit[labels, c, b] - matrixUnit[labels, b, c]) +
    (mu x)^-1 (matrixUnit[labels, a, d] - matrixUnit[labels, d, a] +
      lambda^-1 (matrixUnit[labels, b, d] - matrixUnit[labels, d, b]));
  id + (u^2 - u^-2)/k1[x] (m1 +
    (k2[x] m2 + (nu + nu^-1) m3)/
      (k2[-nu^-2 x] k2[-nu^2 x])) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

bareA1[n_Integer] := IdentityMatrix[n + 1, SparseArray];

bareA2[n_Integer, q_] := Module[{size = n + 1},
  If[!EvenQ[size] || size <= 2, Return[$Failed]];
  SparseArray@Sum[
    q^(1/2) matrixUnit[Range[size], 2 i - 1, 2 i] -
      q^(-1/2) matrixUnit[Range[size], 2 i, 2 i - 1],
    {i, 1, size/2}
  ]
];

bareA4[n_Integer, u_] := Module[{size = n + 1, half},
  If[!EvenQ[size] || size <= 2, Return[$Failed]];
  half = size/2;
  SparseArray@Sum[
    u matrixUnit[Range[size], i + half, i] +
      matrixUnit[Range[size], i, i + half],
    {i, 1, half}
  ]
];

bareA3[n_Integer, ell_Integer, r_Integer, t_Integer, u_, params_Association] := Module[
  {size = n + 1, lambda, mu, labels, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r && 2 r <= t <= size), Return[$Failed]];
  lambda = Lookup[params, "Lambda", Symbol["\[Lambda]"]];
  mu = Lookup[params, "Mu", Symbol["\[Mu]"]];
  labels = Range[size];
  id = IdentityMatrix[size, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[lambda mu u matrixUnit[labels, i, i], {i, 1, ell}] +
    Sum[matrixUnit[labels, i, i], {i, t - ell + 1, size}];
  m2 = Sum[
    lambda matrixUnit[labels, i, i] +
      lambda^-1 matrixUnit[labels, t + 1 - i, t + 1 - i] +
      matrixUnit[labels, i, t + 1 - i] + matrixUnit[labels, t + 1 - i, i],
    {i, ell + 1, r}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareBD1[type_String, n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[type === "B.1", Range[-n, n], Join[Range[-n, -1], Range[1, n]]];
  lambda = Lookup[params, "Lambda", q^(Length[labels]/2 - r)];
  mu = Lookup[params, "Mu", q^-ell];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] + matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareC1[n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  lambda = Lookup[params, "Lambda",
    If[r == n, Symbol["\[Lambda]"], q^(n + 1 - r)]];
  mu = Lookup[params, "Mu",
    If[ell == 0, Symbol["\[Mu]"], q^(-ell - 1)]];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 - (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    -lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] - matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareC2[n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, epsilon},
  If[!(0 <= ell <= r <= n && EvenQ[r - ell]), Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  lambda = Lookup[params, "Lambda", q^(n - r)];
  mu = Lookup[params, "Mu", q^-ell];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    epsilon = (-1)^(i + n + 1 - ell);
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      epsilon (matrixUnit[labels, i, -i - epsilon] +
        matrixUnit[labels, -i - epsilon, i]),
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareBD2[type_String, n_Integer, ell_Integer, r_Integer, u_, q_, params_Association] := Module[
  {labels, size, lambda, mu, id, k1, k2, m1, m2, epsilon},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[type === "B.2", Range[-n, n], Join[Range[-n, -1], Range[1, n]]];
  size = Length[labels];
  lambda = Lookup[params, "Lambda",
    If[type === "D.2" && MemberQ[{n - 1, n}, r],
      Symbol["\[Lambda]"], q^(size/2 - r - 1)]];
  mu = Lookup[params, "Mu",
    If[MemberQ[{0, 1}, ell], Symbol["\[Mu]"], q^(-ell + 1)]];
  id = IdentityMatrix[size, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 - (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = If[ell == 1,
      -u^-1 (mu - mu^-1) matrixUnit[labels, n, n], 0 id] +
    If[type === "D.2" && r == n - 1,
      -(lambda - lambda^-1) matrixUnit[labels, 1, 1], 0 id] +
    Sum[
      epsilon = (-1)^(n + 1 - i - ell);
      -lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
        epsilon (matrixUnit[labels, -i - epsilon, i] -
          matrixUnit[labels, i, -i - epsilon]),
      {i, n - r + 1, n - ell}
    ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareTwistedMinusPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[family === "tB*.1", Join[Range[-n, -1], Range[1, n]], Range[-n, n]];
  lambda = Lookup[params, "Lambda", Switch[family,
    "tB*.1", I q^(n - r),
    "C**.1", I q^(n + 1/2 - r)
  ]];
  mu = Lookup[params, "Mu", Switch[family,
    "tB*.1", q^(-ell - 1),
    "C**.1", If[ell == 0, Symbol["\[Mu]"], q^(-ell - 1)]
  ]];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 - (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    -lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] - matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareSquaredPlain1[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, special = "0p", x = u^2},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[family === "tC**.1",
    Join[Range[-n, -1], {special}, Range[1, n]],
    Join[Range[-n, -1], {0, special}, Range[1, n]]
  ];
  lambda = Lookup[params, "Lambda", Switch[family,
    "tC**.1", If[r == n, Symbol["\[Lambda]"], I q^(n + 1 - r)],
    "C*.1", q^(n - r + 1/2)
  ]];
  mu = Lookup[params, "Mu", q^(-ell - 1/2)];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  m1 = Sum[
    lambda mu x matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    lambda matrixUnit[labels, -i, -i] + lambda^-1 matrixUnit[labels, i, i] +
      matrixUnit[labels, -i, i] + matrixUnit[labels, i, -i],
    {i, n - r + 1, n - ell}
  ];
  id + (u^2 - u^-2)/k1[x] (m1 + m2/k2[x]) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

bareTwistedAlternating[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, epsilon, symmetric},
  If[!(0 <= ell <= r <= n), Return[$Failed]];
  labels = If[family === "C**.2", Range[-n, n],
    Join[Range[-n, -1], Range[1, n]]];
  lambda = Lookup[params, "Lambda", Switch[family,
    "B*.2", I q^(n - r),
    "tB*.2", If[MemberQ[{n - 1, n}, r], Symbol["\[Lambda]"],
      I q^(n - r - 1)],
    "C**.2", I q^(n - r - 1/2)
  ]];
  mu = Lookup[params, "Mu", Switch[family,
    "B*.2", If[MemberQ[{0, 1}, ell], Symbol["\[Mu]"], q^(-ell + 1)],
    "tB*.2" | "C**.2", q^-ell
  ]];
  symmetric = MemberQ[{"tB*.2", "C**.2"}, family];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + If[family === "B*.2", -1, 1] (mu u)^-1;
  m1 = Sum[
    lambda mu u matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
      epsilon = (-1)^(n + 1 - i - ell);
      If[symmetric, lambda, -lambda] matrixUnit[labels, -i, -i] +
        lambda^-1 matrixUnit[labels, i, i] +
        epsilon (matrixUnit[labels, -i - epsilon, i] +
          If[symmetric, 1, -1] matrixUnit[labels, i, -i - epsilon]),
      {i, n - r + 1, n - ell}
    ] +
    If[family === "B*.2" && ell == 1,
      -u^-1 (mu - mu^-1) matrixUnit[labels, n, n], 0 id] +
    If[family === "tB*.2" && r == n - 1,
      (lambda + lambda^-1) matrixUnit[labels, 1, 1], 0 id];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareSquaredAlternating[family_String, n_Integer, ell_Integer, r_Integer,
    u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, epsilon,
   special = "0p", x = u^2},
  If[!MemberQ[{"tC**.2", "C*.2"}, family] || !(0 <= ell <= r <= n),
    Return[$Failed]
  ];
  labels = If[family === "tC**.2",
    Join[Range[-n, -1], {special}, Range[1, n]],
    Join[Range[-n, -1], {0, special}, Range[1, n]]
  ];
  lambda = Lookup[params, "Lambda", If[family === "tC**.2",
    I q^(n - r), q^(n - r - 1/2)]];
  mu = Lookup[params, "Mu", q^(-ell + 1/2)];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 - (mu y)^-1;
  m1 = Sum[
    lambda mu x matrixUnit[labels, -i, -i] + matrixUnit[labels, i, i],
    {i, n - ell + 1, n}
  ];
  m2 = Sum[
    epsilon = (-1)^(n + 1 - i - ell);
    -lambda matrixUnit[labels, -i, -i] +
      lambda^-1 matrixUnit[labels, i, i] +
      epsilon (matrixUnit[labels, -i - epsilon, i] -
        matrixUnit[labels, i, -i - epsilon]),
    {i, n - r + 1, n - ell}
  ];
  id + (u^2 - u^-2)/k1[x] (m1 + m2/k2[x]) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

bareCD4[family_String, n_Integer, ell_Integer, u_, q_,
    params_Association] := Module[
  {labels, lambda, mu, alpha, id, k1, k2, m1, m2, m2plus,
   m2minus, k2minus, bar},
  If[!MemberQ[{"C.4", "D.4"}, family] ||
      !(0 <= ell <= Floor[n/2]), Return[$Failed]];
  labels = Join[Range[-n, -1], Range[1, n]];
  lambda = Lookup[params, "Lambda", Symbol["\[Lambda]"]];
  alpha = Lookup[params, "Alpha", 1];
  mu = Lookup[params, "Mu", q^(-n + 2 ell) *
    If[family === "D.4" && ell == 1, alpha, 1] lambda];
  id = IdentityMatrix[2 n, SparseArray];
  k1 = lambda mu - u;
  k2 = lambda^-1 + (mu u)^-1;
  m1 = Sum[matrixUnit[labels, i, i], {i, 1, n}];
  If[family === "D.4" && ell == 1,
    m2plus = u^-1 (mu^-1 matrixUnit[labels, 1, 1] +
      mu matrixUnit[labels, n, n] + matrixUnit[labels, 1, n] +
      matrixUnit[labels, n, 1]);
    k2minus = (alpha lambda)^-1 + alpha (mu u)^-1;
    m2minus = (alpha lambda)^-1 matrixUnit[labels, -1, -1] +
      alpha lambda matrixUnit[labels, -n, -n] +
      matrixUnit[labels, -1, -n] + matrixUnit[labels, -n, -1];
    Return[id + (u - u^-1)/k1 (m1 - m2plus/k2 + m2minus/k2minus)]
  ];
  m2 = Sum[
    bar = n + 1 - i;
    lambda matrixUnit[labels, -i, -i] +
      lambda^-1 matrixUnit[labels, -bar, -bar] +
      matrixUnit[labels, -i, -bar] + matrixUnit[labels, -bar, -i] -
      u^-1 (mu matrixUnit[labels, i, i] +
        mu^-1 matrixUnit[labels, bar, bar] +
        matrixUnit[labels, i, bar] + matrixUnit[labels, bar, i]),
    {i, n - ell + 1, n}
  ];
  id + (u - u^-1)/k1 (m1 + m2/k2)
];

bareCStar4[n_Integer, ell_Integer, u_, q_, params_Association] := Module[
  {labels, lambda, mu, id, k1, k2, m1, m2, bar,
   special = "0p", x = u^2},
  If[!(0 <= ell <= Floor[n/2]), Return[$Failed]];
  labels = Join[Range[-n, -1], {0, special}, Range[1, n]];
  lambda = Lookup[params, "Lambda", Symbol["\[Lambda]"]];
  mu = Lookup[params, "Mu", q^(-n + 2 ell) lambda];
  id = IdentityMatrix[Length[labels], SparseArray];
  k1[y_] := lambda mu - y;
  k2[y_] := lambda^-1 + (mu y)^-1;
  m1 = Sum[matrixUnit[labels, i, i], {i, 1, n}];
  m2 = lambda^-1 matrixUnit[labels, 0, 0] -
      mu matrixUnit[labels, special, special] +
      I u^-1 (matrixUnit[labels, special, 0] -
        matrixUnit[labels, 0, special]) +
    Sum[
      bar = n + 1 - i;
      lambda matrixUnit[labels, -i, -i] +
        lambda^-1 matrixUnit[labels, -bar, -bar] -
        matrixUnit[labels, -i, -bar] - matrixUnit[labels, -bar, -i] -
        u^-2 (mu matrixUnit[labels, i, i] +
          mu^-1 matrixUnit[labels, bar, bar] -
          matrixUnit[labels, i, bar] - matrixUnit[labels, bar, i]),
      {i, n - ell + 1, n}
    ];
  id + (u^2 - u^-2)/k1[x] (m1 + m2/k2[x]) +
    (u^2 k1[u^-2]/k1[x] - 1) matrixUnit[labels, special, special]
];

applyDressing[m_?MatrixQ, Identity, _] := m;
applyDressing[m_?MatrixQ, g_?MatrixQ, "Standard"] := Inverse[g].m.g;
applyDressing[m_?MatrixQ, g_?MatrixQ, "Transposed"] := g.m.g;

transportCatalogueResult[d_?SatakeDiagramQ, u_, classification_Association,
    q_, extraParams_Association, dress_, eta_, simplify_, reason_String] := Module[
  {type = d["AffineType"], n = d["Rank"], family, sigma, spectral,
   base, automorphism, g, transported, provenance},
  family = classification["RepresentativeFamily"];
  sigma = If[reason === "DiagramAutomorphism",
    classification["RepresentativePermutation"], d["Tau"]];
  If[!StringQ[family] || !ListQ[sigma],
    Return[Failure["MissingTransportData", classification]]
  ];
  base = KMatrix[<|"Rank" -> n, "Family" -> family,
      "Parameters" -> classification["Parameters"]|>, u,
    "QuantumParameter" -> q, "Parameters" -> extraParams,
    "DressingMatrix" -> Identity];
  If[!AssociationQ[base] || !MatrixQ[base["KMatrix"]],
    Return[Failure["TransportRepresentativeUnavailable", <|
      "Classification" -> classification, "RepresentativeResult" -> base|>]]
  ];
  spectral = Unique["z$transport"];
  automorphism = DiagramAutomorphismIntertwiner[type, n, sigma, spectral, q,
    "SimplifyFunction" -> simplify];
  If[FailureQ[automorphism], Return[automorphism]];
  g = automorphism["Intertwiner"];
  transported = simplify[
    Inverse[g /. spectral -> eta/u].base["KMatrix"].
      (g /. spectral -> eta u)];
  transported = applyDressing[transported, dress, base["Equation"]];
  provenance = Lookup[base, "Provenance", <||>];
  If[!AssociationQ[provenance], provenance = <|"Source" -> provenance|>];
  Join[base, <|"KMatrix" -> transported,
    "Classification" -> classification,
    "Transport" -> <|"Reason" -> reason, "Permutation" -> sigma,
      "Intertwiner" -> g, "ScalingParameter" -> eta|>,
    "Provenance" -> Join[provenance, <|
      "Transport" -> "RepresentationDiagramAutomorphismIntertwiner",
      "TransportPermutation" -> sigma|>]|>]
];

KMatrix::family = "No catalogued closed formula is implemented for family `1`. Supply IntertwinerData or use SolveBoundaryIntertwiner directly.";
KMatrix::params = "Family B*.1 requires integer parameters 0 <= l <= r <= n.";
KMatrix::familyparams = "Family `1` received incompatible or missing classification parameters `2`.";
KMatrix::rank = "Family `1` is not defined at rank n=`2`.";
KMatrix::ambiguous = "The diagram has overlapping candidate families `1`; specify \"Family\" or supply coideal parameters for a derived intertwiner.";
KMatrix::nonquasi = "The diagram is in the non-quasistandard `1` regime. Supply explicit coideal parameters for an intertwiner solve, or request a separately implemented non-quasistandard formula.";
KMatrix::novector = "The classified `1` regime has no vector K-matrix in qRE.";
KMatrix::rotation = "The diagram is classified as `1` only after the diagram automorphism `2`; automatic transport of the closed formula has not been encoded.";
KMatrix::transport = "The diagram belongs to family `1`, but its fork-exchange representative requires a matrix-level transport that has not yet been encoded.";

KMatrix[d_Association, u_, OptionsPattern[]] := Module[
  {method = OptionValue["Method"], family = OptionValue["Family"], params,
   data, result, dress = OptionValue["DressingMatrix"], n, ell, r, cparams, sparams,
   classification = <||>, explicitBoundaryData, catalogueEntry, transported,
   nonQuasiFormula = False},
  If[SatakeDiagramQ[d], classification = ClassifySatakeDiagram[d]];
  If[family === Automatic, family = Lookup[d, "Family", Automatic]];
  If[family === Automatic && AssociationQ[classification],
    family = Lookup[classification, "Family", Automatic]
  ];
  params = Join[Lookup[classification, "Parameters", <||>],
    Lookup[d, "Parameters", <||>], OptionValue["Parameters"]];
  nonQuasiFormula = Lookup[classification, "Regime", None] ===
      "NonQuasistandard" ||
    Lookup[params, "Regime", None] === "NonQuasistandard" ||
    nonQuasiParameterRequestQ[family, Lookup[d, "Rank", Missing[]],
      Lookup[params, "l", Missing[]], Lookup[params, "r", Missing[]], params];
  explicitBoundaryData = OptionValue["CParameters"] =!= Automatic ||
    OptionValue["SParameters"] =!= Automatic || OptionValue["Equation"] =!= Automatic;
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "Regime", None] === "NonQuasistandard",
    n = d["Rank"]; ell = Lookup[params, "l", Missing[]];
    r = Lookup[params, "r", Missing[]];
    If[!supportedNonQuasiFormulaQ[family, n, ell, r],
      Message[KMatrix::nonquasi, Lookup[classification, "RepresentativeFamily", family]];
      Return[Failure["NonQuasistandardFormulaRequired", classification]]
    ]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "Regime", None] === "NoVectorKMatrix",
    Message[KMatrix::novector, Lookup[classification, "RepresentativeFamily", family]];
    Return[Failure["NoVectorKMatrix", classification]]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "ClassificationStatus", None] ===
        "ClassifiedUpToDiagramAutomorphism",
    transported = transportCatalogueResult[d, u, classification,
      OptionValue["QuantumParameter"], OptionValue["Parameters"], dress,
      OptionValue["ScalingParameter"], OptionValue["SimplifyFunction"],
      "DiagramAutomorphism"];
    If[AssociationQ[transported], Return[transported]];
    Message[KMatrix::rotation, Lookup[classification, "RepresentativeFamily", family],
      Lookup[classification, "RepresentativePermutation", Missing[]]];
    Return[Failure["DiagramAutomorphismTransportRequired", <|
      "Classification" -> classification, "Cause" -> transported|>]]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && !TrueQ[explicitBoundaryData] &&
      Lookup[classification, "Regime", None] === "FormulaTransportPending",
    transported = transportCatalogueResult[d, u, classification,
      OptionValue["QuantumParameter"], OptionValue["Parameters"], dress,
      OptionValue["ScalingParameter"], OptionValue["SimplifyFunction"],
      "ForkExchange"];
    If[AssociationQ[transported], Return[transported]];
    Message[KMatrix::transport, Lookup[classification, "RepresentativeFamily", family]];
    Return[Failure["FormulaTransportRequired", <|
      "Classification" -> classification, "Cause" -> transported|>]]
  ];
  If[method === Automatic && SatakeDiagramQ[d] && MissingQ[family] &&
      !TrueQ[explicitBoundaryData] && !KeyExistsQ[d, "IntertwinerData"],
    Message[KMatrix::ambiguous, Lookup[classification, "CandidateFamilies", {}]];
    Return[Failure["AmbiguousKMatrixFamily", classification]]
  ];
  catalogueEntry = If[StringQ[family], Lookup[$catalogue, family, <||>], <||>];
  If[method === Automatic,
    method = Which[
      KeyExistsQ[d, "IntertwinerData"] || explicitBoundaryData, "Intertwiner",
      Lookup[catalogueEntry, "Implementation", None] === "ClosedForm", "Catalogue",
      SatakeDiagramQ[d], "Intertwiner",
      StringQ[family], "Catalogue",
      True, "Catalogue"
    ]
  ];
  Switch[method,
    "Intertwiner",
      data = Lookup[d, "IntertwinerData", Missing["NotAvailable"]];
      If[MissingQ[data],
        If[!SatakeDiagramQ[d], Return[Failure["MissingIntertwinerData", <||>]]];
        cparams = Replace[OptionValue["CParameters"], Automatic :> Lookup[d, "CParameters", <||>]];
        sparams = Replace[OptionValue["SParameters"], Automatic :> Lookup[d, "SParameters", <||>]];
        DeriveKMatrix[d, u, OptionValue["QuantumParameter"], cparams, sparams,
          "ScalingParameter" -> OptionValue["ScalingParameter"],
          "Equation" -> OptionValue["Equation"],
          "NormalizeAt" -> OptionValue["NormalizeAt"],
          "SimplifyFunction" -> OptionValue["SimplifyFunction"]],
        result = SolveBoundaryIntertwiner[data["Left"], data["Right"]];
        If[AssociationQ[result], Append[result, "Provenance" -> "BoundaryIntertwinerSolve"], result]
      ],
    "Catalogue",
      Switch[family,
        "A.1",
          n = Lookup[d, "Rank", Missing["Rank"]];
          If[!IntegerQ[n] || n <= 1, Message[KMatrix::rank, family, n]; Return[$Failed]];
          result = bareA1[n];
          <|"KMatrix" -> applyDressing[result, dress, "Transposed"],
            "Family" -> family, "Equation" -> "Transposed",
            "BasisLabels" -> Range[n + 1], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/resultsA124.tex",
              "Formula" -> "A.1", "ResearchStatus" -> "qREFormula"|>|>,
        "A.2",
          n = Lookup[d, "Rank", Missing["Rank"]];
          result = If[IntegerQ[n], bareA2[n, OptionValue["QuantumParameter"]], $Failed];
          If[result === $Failed, Message[KMatrix::rank, family, n]; Return[$Failed]];
          <|"KMatrix" -> applyDressing[result, dress, "Transposed"],
            "Family" -> family, "Equation" -> "Transposed",
            "BasisLabels" -> Range[n + 1], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/resultsA124.tex",
              "Formula" -> "A.2", "ResearchStatus" -> "qREFormula"|>|>,
        "A.3",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          data = Lookup[params, "t", n + 1];
          result = If[And @@ (IntegerQ /@ {n, ell, r, data}),
            bareA3[n, ell, r, data, u, params], $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r, "t" -> data|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> Range[n + 1], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/resultsA3.tex",
              "Formula" -> "A.3", "ResearchStatus" -> "qREFormula"|>|>,
        "A.4",
          n = Lookup[d, "Rank", Missing["Rank"]];
          result = If[IntegerQ[n], bareA4[n, u], $Failed];
          If[result === $Failed, Message[KMatrix::rank, family, n]; Return[$Failed]];
          <|"KMatrix" -> applyDressing[result, dress, "Transposed"],
            "Family" -> family, "Equation" -> "Transposed",
            "BasisLabels" -> Range[n + 1], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/resultsA124.tex",
              "Formula" -> "A.4", "ResearchStatus" -> "qREFormula"|>|>,
        "B.1" | "D.1",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          result = If[And @@ (IntegerQ /@ {n, ell, r}),
            bareBD1[family, n, ell, r, u, OptionValue["QuantumParameter"], params], $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> If[family === "B.1", Range[-n, n],
              Join[Range[-n, -1], Range[1, n]]], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/results.tex",
              "Formula" -> family, "ResearchStatus" -> "qREFormula"|>|>,
        "C.1" | "C.2",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          result = If[And @@ (IntegerQ /@ {n, ell, r}),
            If[family === "C.1",
              bareC1[n, ell, r, u, OptionValue["QuantumParameter"], params],
              bareC2[n, ell, r, u, OptionValue["QuantumParameter"], params]], $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> Join[Range[-n, -1], Range[1, n]],
            "Parameters" -> params,
            "Provenance" -> <|"Source" -> If[family === "C.1",
                "qRE/files/resultsC1BD2.tex", "qRE/files/resultsBD1C2.tex"],
              "Formula" -> family, "ResearchStatus" -> "qREFormula"|>|>,
        "B.2" | "D.2",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          result = If[And @@ (IntegerQ /@ {n, ell, r}),
            bareBD2[family, n, ell, r, u, OptionValue["QuantumParameter"], params],
            $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> If[family === "B.2", Range[-n, n],
              Join[Range[-n, -1], Range[1, n]]], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/resultsC1BD2.tex",
              "Formula" -> family, "ResearchStatus" -> "qREFormula"|>|>,
        "tB*.1" | "C**.1",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          result = If[And @@ (IntegerQ /@ {n, ell, r}),
            If[MemberQ[{"tB*.1", "C**.1"}, family] && nonQuasiFormula,
              If[family === "C**.1" && {ell, r} === {n - 1, n},
                bareNonQuasiCMinusEndpoint[n, ell, r, u,
                  OptionValue["QuantumParameter"], params],
                bareNonQuasiPlain1[family, n, ell, r, u,
                  OptionValue["QuantumParameter"], params]],
              bareTwistedMinusPlain1[family, n, ell, r, u,
                OptionValue["QuantumParameter"], params]], $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> If[family === "tB*.1",
              Join[Range[-n, -1], Range[1, n]], Range[-n, n]],
            "Parameters" -> params,
            "Provenance" -> <|"Source" -> If[nonQuasiFormula,
                "qRE_II/nqs_temp.tex", "qRE_II/plain_temp.tex"],
              "Formula" -> family,
              "NotebookSymbol" -> Which[
                nonQuasiFormula && family === "C**.1" &&
                  {ell, r} === {n - 1, n}, "KCB1xx",
                nonQuasiFormula && family === "C**.1", "KCB1x",
                True, Missing["NotRecorded"]],
              "Branch" -> Which[
                nonQuasiFormula && family === "C**.1" &&
                  {ell, r} === {n - 1, n},
                    "NonQuasistandardEndpointN",
                nonQuasiFormula, "NonQuasistandardGeneric",
                True, "MainCatalogue"],
              "ResearchStatus" -> "NotebookChecked"|>|>,
        "tC**.1" | "C*.1",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          result = If[And @@ (IntegerQ /@ {n, ell, r}),
            If[nonQuasiFormula,
              Which[
                family === "tC**.1" && {ell, r} === {0, 1},
                  bareNonQuasiTCMinusEndpoint[n, ell, r, u,
                    OptionValue["QuantumParameter"], params],
                family === "C*.1" && {ell, r} === {0, 1},
                  bareNonQuasiCStarEndpoint[n, ell, r, u,
                    OptionValue["QuantumParameter"], params],
                True, bareNonQuasiSquaredPlain1[family, n, ell, r, u,
                  OptionValue["QuantumParameter"], params]],
              bareSquaredPlain1[family, n, ell, r, u,
                OptionValue["QuantumParameter"], params]], $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> If[family === "tC**.1",
              Join[Range[-n, -1], {"0p"}, Range[1, n]],
              Join[Range[-n, -1], {0, "0p"}, Range[1, n]]],
            "Parameters" -> params,
            "Provenance" -> <|"Source" -> If[nonQuasiFormula,
                "qRE_II/nqs_temp.tex",
                "qRE_II/Mathematica/qRE-II-July-9.nb"],
              "Formula" -> family, "NotebookSymbol" -> If[family === "tC**.1",
                Which[
                  nonQuasiFormula && {ell, r} === {0, 1}, "KBC1xx",
                  nonQuasiFormula, "KBC1x",
                  True, "KBC1"],
                Which[
                  nonQuasiFormula && {ell, r} === {0, 1}, "KBB1xx",
                  nonQuasiFormula, "KBB1x",
                  True, "KBB1"]],
              "Branch" -> Which[
                nonQuasiFormula && family === "tC**.1" &&
                  {ell, r} === {0, 1}, "NonQuasistandardEndpoint0",
                nonQuasiFormula && family === "C*.1" &&
                  {ell, r} === {0, 1}, "NonQuasistandardEndpoint0",
                nonQuasiFormula, "NonQuasistandardGeneric",
                True, "MainCatalogue"],
              "ResearchStatus" -> "NotebookChecked"|>|>,
        "B*.2" | "tB*.2" | "C**.2",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          result = If[And @@ (IntegerQ /@ {n, ell, r}),
            bareTwistedAlternating[family, n, ell, r, u,
              OptionValue["QuantumParameter"], params], $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> If[family === "C**.2", Range[-n, n],
              Join[Range[-n, -1], Range[1, n]]], "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE_II/alt_temp.tex",
              "Formula" -> family, "ResearchStatus" -> "NotebookChecked"|>|>,
        "tC**.2" | "C*.2",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          result = If[And @@ (IntegerQ /@ {n, ell, r}),
            bareSquaredAlternating[family, n, ell, r, u,
              OptionValue["QuantumParameter"], params], $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> If[family === "tC**.2",
              Join[Range[-n, -1], {"0p"}, Range[1, n]],
              Join[Range[-n, -1], {0, "0p"}, Range[1, n]]],
            "Parameters" -> params,
            "Provenance" -> <|
              "Source" -> "qRE_II/Mathematica/qRE-II-July-9.nb",
              "Formula" -> family,
              "NotebookSymbol" -> If[family === "tC**.2", "KBC2", "KBB2"],
              "ResearchStatus" -> "NotebookChecked"|>|>,
        "C.4" | "D.4",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          result = If[IntegerQ[n] && IntegerQ[ell],
            bareCD4[family, n, ell, u, OptionValue["QuantumParameter"], params],
            $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> Join[Range[-n, -1], Range[1, n]],
            "Parameters" -> params,
            "Provenance" -> <|"Source" -> "qRE/files/resultsCD4.tex",
              "Formula" -> family,
              "Branch" -> If[family === "D.4" && ell == 1,
                "SpecialTwoParameter", "Generic"],
              "ResearchStatus" -> "qREFormula"|>|>,
        "C*.4",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          result = If[IntegerQ[n] && IntegerQ[ell],
            bareCStar4[n, ell, u, OptionValue["QuantumParameter"], params],
            $Failed];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell|>];
            Return[$Failed]
          ];
          <|"KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> Join[Range[-n, -1], {0, "0p"}, Range[1, n]],
            "Parameters" -> params,
            "Provenance" -> <|
              "Source" -> "qRE_II/Mathematica/qRE-II-July-9.nb",
              "Formula" -> family, "NotebookSymbol" -> "KBB4",
              "ResearchStatus" -> "FormulaPresentPropertiesUnfinished"|>|>,
        "B*.1",
          n = Lookup[d, "Rank", Missing["Rank"]];
          ell = Lookup[params, "l", Missing["l"]];
          r = Lookup[params, "r", Missing["r"]];
          If[!IntegerQ[n] || !IntegerQ[ell] || !IntegerQ[r] || !(0 <= ell <= r <= n),
            Message[KMatrix::params]; Return[$Failed]
          ];
          result = If[nonQuasiFormula,
            If[{ell, r} === {0, 2},
              bareNonQuasiBEndpoint[n, ell, r, u,
                OptionValue["QuantumParameter"], params],
              bareNonQuasiPlain1[family, n, ell, r, u,
                OptionValue["QuantumParameter"], params]],
            bareBDC1[n, ell, r, u, OptionValue["QuantumParameter"], params]];
          If[result === $Failed,
            Message[KMatrix::familyparams, family, <|"l" -> ell, "r" -> r|>];
            Return[$Failed]
          ];
          <|
            "KMatrix" -> applyDressing[result, dress, "Standard"],
            "Family" -> family, "Equation" -> "Standard",
            "BasisLabels" -> Join[Range[-n, -1], Range[1, n]],
            "Parameters" -> params,
            "Provenance" -> <|
              "Source" -> If[nonQuasiFormula, "qRE_II/nqs_temp.tex",
                "qRE_II/Mathematica/qRE-II.nb"],
              "NotebookSymbol" -> Which[
                nonQuasiFormula && {ell, r} === {0, 2}, "KDC1xx",
                nonQuasiFormula, "KDC1x",
                True, "KDC1"],
              "Branch" -> Which[
                nonQuasiFormula && {ell, r} === {0, 2},
                  "NonQuasistandardEndpoint01",
                nonQuasiFormula, "NonQuasistandardGeneric",
                True, "MainCatalogue"],
              "ResearchStatus" -> "NotebookChecked"
            |>
          |>,
        _, Message[KMatrix::family, family];
          Failure["FormulaNotImplemented", <|"Family" -> family, "Catalogue" -> Lookup[$catalogue, family, Missing["UnknownFamily"]]|>]
      ],
    _, Failure["UnknownMethod", <|"Method" -> method|>]
  ]
];

Options[KMatrixCandidates] = Options[KMatrix];
KMatrixCandidates[d_?SatakeDiagramQ, u_, opts : OptionsPattern[]] := Module[
  {classification = ClassifySatakeDiagram[d], families, kOptions, result},
  families = classification["CandidateFamilies"];
  If[!ListQ[families] || families === {}, Return[{}]];
  kOptions = DeleteCases[FilterRules[{opts}, Options[KMatrix]],
    ("Family" -> _) | ("Method" -> _)];
  Map[
    Function[family,
      result = Quiet[KMatrix[<|"Rank" -> d["Rank"], "Family" -> family,
          "Parameters" -> classification["Parameters"]|>, u,
        Sequence @@ kOptions, "Method" -> "Catalogue"]];
      <|"Family" -> family,
        "Parameters" -> classification["Parameters"],
        "Status" -> Which[
          AssociationQ[result] && KeyExistsQ[result, "KMatrix"], "Computed",
          result === $Failed, "Failed",
          FailureQ[result], result["Tag"],
          True, "Unavailable"],
        "Result" -> result,
        "Classification" -> classification|>
    ],
    families
  ]
];

Options[KMatrixTable] = Join[Options[KMatrix], {
  "ComputedOnly" -> False, "ResolveAmbiguities" -> True}];
KMatrixTable[type_String, n_Integer, u_, opts : OptionsPattern[]] := Module[
  {diagrams, kOptions, records, computedOnly = OptionValue["ComputedOnly"],
   resolveAmbiguities = OptionValue["ResolveAmbiguities"], classification,
   result, status, candidates},
  diagrams = GeneralizedSatakeDiagrams[type, n];
  If[diagrams === $Failed, Return[$Failed]];
  kOptions = FilterRules[{opts}, Options[KMatrix]];
  records = Map[
    Function[diagram,
      classification = ClassifySatakeDiagram[diagram];
      result = Quiet[KMatrix[diagram, u, Sequence @@ kOptions]];
      If[TrueQ[resolveAmbiguities] && FailureQ[result] &&
          result["Tag"] === "AmbiguousKMatrixFamily",
        candidates = KMatrixCandidates[diagram, u, Sequence @@ kOptions];
        If[candidates =!= {},
          result = <|"Candidates" -> candidates,
            "Classification" -> classification|>
        ]
      ];
      status = Which[
        AssociationQ[result] && KeyExistsQ[result, "KMatrix"], "Computed",
        AssociationQ[result] && KeyExistsQ[result, "Candidates"] &&
            AllTrue[result["Candidates"], #["Status"] === "Computed" &],
          "MultipleCandidates",
        AssociationQ[result] && KeyExistsQ[result, "Candidates"],
          "CandidateResults",
        result === $Failed,
          Replace[classification["ClassificationStatus"],
            "Classified" -> "Failed"],
        FailureQ[result], result["Tag"],
        True, "Unavailable"
      ];
      <|"Diagram" -> diagram,
        "Family" -> classification["Family"],
        "Parameters" -> classification["Parameters"],
        "Classification" -> classification,
        "Status" -> status,
        "Result" -> result|>
    ],
    diagrams
  ];
  If[TrueQ[computedOnly], Select[records, #["Status"] === "Computed" &], records]
];

(* Scientific presentation records --------------------------------------- *)

QSPPresentationData[d_?SatakeDiagramQ] := Module[
  {nodes = d["Nodes"], x = d["X"], tau = d["Tau"], outside, word,
   orbitRepresentatives, diagramID},
  outside = Complement[nodes, x];
  word = LongestParabolicWord[d["CartanMatrix"], x];
  orbitRepresentatives = DeleteDuplicates[
    Min[#, tau[[# + 1]]] & /@ outside];
  diagramID = webDiagramID[d];
  <|
    "qspId" -> diagramID <> "--qsp",
    "status" -> "instantiatedPresentation",
    "nameLatex" -> "B_{\\mathbf c,\\mathbf s}(X,\\tau)",
    "ambientAlgebraLatex" -> "U_q(\\mathfrak g)",
    "indexSets" -> <|
      "nodes" -> nodes, "levi" -> x, "boundary" -> outside,
      "torusOrbitRepresentatives" -> orbitRepresentatives|>,
    "theta" -> <|
      "kind" -> "KolbQuantumInvolution",
      "longestParabolicWord" -> word,
      "latex" -> "\\theta_q=T_{w_X}\\,\\tau\\,\\omega_q"|>,
    "generatorGroups" -> {
      <|"kind" -> "positiveLevi", "nodes" -> x,
        "latex" -> "U_q(\\mathfrak n_X^+)=\\langle x_i\\mid i\\in X\\rangle"|>,
      <|"kind" -> "thetaFixedTorus", "nodes" -> orbitRepresentatives,
        "latex" -> "U_q(\\mathfrak h)^{\\theta_q}=\\langle k_i^{\\pm1}\\ (i\\in X),\\ k_jk_{\\tau(j)}^{-1},\\ k_j^{-1}k_{\\tau(j)}\\ (j\\in I^*)\\rangle"|>,
      <|"kind" -> "boundary", "nodes" -> nodes,
        "latex" -> "b_i=\\begin{cases}y_i,&i\\in X,\\\\ y_i+c_i\\theta_q(y_i k_i)k_i^{-1}-s_i k_i^{-1},&i\\notin X.\\end{cases}"|>
    },
    "presentationLatex" ->
      "B_{\\mathbf c,\\mathbf s}(X,\\tau)=\\langle U_q(\\mathfrak n_X^+),\\ U_q(\\mathfrak h)^{\\theta_q},\\ b_i\\ (i\\in I)\\rangle",
    "parameters" -> <|
      "cNodes" -> outside, "sNodes" -> outside,
      "latex" -> "\\mathbf c\\in(\\mathbb K^\\times)^{I\\setminus X},\\qquad \\mathbf s\\in\\mathbb K^{I\\setminus X}"|>,
    "relationStatus" -> "generatorPresentation",
    "provenance" -> <|
      "Source" -> "qRE/files/algebras.tex",
      "Equations" -> {"theta_q", "def:b_j", "def:Bcs"},
      "Convention" -> "KolbDef5.6Variation2"|>
  |>
];

ambientRFormulaKind[type_String] := Switch[canonicalType[type],
  "A(1)", "untwistedTypeA",
  "B(1)" | "C(1)" | "D(1)", "untwistedBCD",
  "A2n-1(2)" | "A2n-1(2)T" | "A2n(2)", "twistedLinear",
  "A2n(2)T" | "Dn+1(2)", "twistedQuadratic"
];

ambientRFormulaLatex[kind_String] := Switch[kind,
  "untwistedTypeA",
    "R(u)=f_q(u)R_q+\\frac{(q-q^{-1})u}{q-q^{-1}u}P",
  "untwistedBCD",
    "R(u)=f_q(u)R_q+\\frac{(q-q^{-1})u}{q-q^{-1}u}\\left(P-\\frac{1-u}{q^{2\\kappa}-u}Q_q\\right)",
  "twistedLinear",
    "R(u)=f_q(u)R_q+\\frac{(q-q^{-1})u}{q-q^{-1}u}\\left(P-\\frac{1-u}{\\widetilde q^{\,2}-u}Q_q\\right)",
  "twistedQuadratic",
    "R(u)=f_q(u^2)R_q+\\frac{(q-q^{-1})u^2}{q-q^{-1}u^2}\\left(P+\\frac{1-u}{u}H-\\frac{1-u^2}{\\widetilde q^{\,4}-u^2}\\left(Q_q+E'+\\frac{\\sqrt{\\vartheta}\\,\\widetilde q^{\,2}}{u}D_q\\right)\\right)"
];

ambientRDefinitions[kind_String] := Join[
  {
    <|"symbol" -> "f_q", "latex" -> "f_q(u)=\\frac{1-u}{q-q^{-1}u}"|>,
    <|"symbol" -> "P", "latex" -> "P=\\sum_{i,j\\in\\langle N\\rangle}E_{ij}\\otimes E_{ji}"|>
  },
  If[kind === "untwistedTypeA",
    {<|"symbol" -> "R_q", "latex" -> "R_q=\\sum_{i,j}\\left(q^{\\delta_{ij}}E_{ii}\\otimes E_{jj}+\\delta_{i<j}(q-q^{-1})E_{ij}\\otimes E_{ji}\\right)"|>},
    {
      <|"symbol" -> "R_q", "latex" -> "R_q=\\sum_{i,j}q^{\\delta_{ij}-\\delta_{i,-j}}E_{ii}\\otimes E_{jj}+(q-q^{-1})\\sum_{i<j}\\left(E_{ij}\\otimes E_{ji}-\\vartheta_i\\vartheta_jq^{\\nu_i-\\nu_j}E_{ij}\\otimes E_{-i,-j}\\right)"|>,
      <|"symbol" -> "Q_q", "latex" -> "Q_q=\\sum_{i,j}\\vartheta_i\\vartheta_jq^{\\nu_i-\\nu_j}E_{ij}\\otimes E_{-i,-j}"|>
    }
  ],
  If[kind === "untwistedBCD",
    {<|"symbol" -> "kappa", "latex" -> "\\kappa=\\frac N2-\\vartheta"|>}, {}],
  If[MemberQ[{"twistedLinear", "twistedQuadratic"}, kind],
    {<|"symbol" -> "qTilde", "latex" -> "\\widetilde q\\text{ is the crossing parameter fixed by the skew self-duality convention}"|>}, {}],
  If[kind === "twistedQuadratic",
    {
      <|"symbol" -> "H", "latex" -> "H=\\sum_i(E_{0'i}\\otimes E_{i0'}+E_{i0'}\\otimes E_{0'i})"|>,
      <|"symbol" -> "EPrime", "latex" -> "E'=E_{0'0'}\\otimes E_{0'0'}"|>,
      <|"symbol" -> "D_q", "latex" -> "D_q=\\sum_i\\vartheta_i\\left(\\vartheta q^{\\nu_i}E_{i0'}\\otimes E_{-i,0'}+q^{-\\nu_i}E_{0'i}\\otimes E_{0',-i}\\right)"|>
    }, {}]
];

AmbientRMatrixData[type_String, n_Integer] := Module[
  {canonical = canonicalType[type], labels, kind, dimension, recordID, source},
  If[MissingQ[canonical] || Quiet[VectorRepresentation[canonical, n]] === $Failed,
    Return[$Failed]];
  labels = representationBasis[canonical, n];
  dimension = Length[labels];
  kind = ambientRFormulaKind[canonical];
  recordID = webSlug[canonical] <> "--n" <> ToString[n] <> "--vector-r";
  source = If[MemberQ[$twistedTypes, canonical],
    "qRE_II/Rmatrices.tex", "qRE/files/Rmatrices.tex"];
  <|
    "representation" -> <|
      "representationId" -> webSlug[canonical] <> "--n" <> ToString[n] <> "--vector",
      "kind" -> "vectorEvaluation", "dimension" -> dimension,
      "basisLabels" -> (webBasisLabel /@ labels),
      "spectralParameter" -> "u", "quantumParameter" -> "q",
      "tensorBasisConvention" -> "lexicographic"|>,
    "rMatrix" -> <|
      "rMatrixId" -> recordID, "status" -> "sourceFormula",
      "formulaKind" -> kind, "dimension" -> dimension^2,
      "latex" -> ambientRFormulaLatex[kind],
      "operatorDefinitions" -> ambientRDefinitions[kind],
      "normalizationLatex" -> "R(1)=P",
      "properties" -> {
        <|"kind" -> "regularity", "status" -> "sourceIdentity", "latex" -> "R(1)=P"|>,
        <|"kind" -> "unitarity", "status" -> "sourceIdentity", "latex" -> "R(u)^{-1}=R_{21}(u^{-1})"|>,
        <|"kind" -> "yangBaxter", "status" -> "sourceIdentity", "latex" -> "R_{12}(u/v)R_{13}(u/w)R_{23}(v/w)=R_{23}(v/w)R_{13}(u/w)R_{12}(u/v)"|>
      },
      "provenance" -> <|
        "Source" -> source, "Normalization" -> "regular",
        "MatrixMaterialization" -> "notExported"|>
    |>
  |>
];

ReflectionEquationData[d_?SatakeDiagramQ, rMatrixId_String] := Module[
  {equation = BoundaryEquationType[d], latex},
  latex = If[equation === "Transposed",
    "R_{21}(u/v)K_1(u)R_{12}^{t_1}(uv)K_2(v)=K_2(v)R_{21}^{t_1}(uv)K_1(u)R_{12}(u/v)",
    "R_{21}(u/v)K_1(u)R_{12}(uv)K_2(v)=K_2(v)R_{21}(uv)K_1(u)R_{12}(u/v)"];
  <|
    "kind" -> equation, "status" -> "instantiatedIdentity",
    "latex" -> latex, "rMatrixId" -> rMatrixId,
    "verification" -> <|"status" -> "notComputed", "method" -> Null|>,
    "conventions" -> <|
      "spectralParameters" -> "multiplicative", "legNumbering" -> "12/21",
      "partialTranspose" -> If[equation === "Transposed", "firstTensorFactor", Null]|>
  |>
];

(* Web interchange --------------------------------------------------------- *)

webSymbolName[s_Symbol] := Last[StringSplit[ToString[Unevaluated[s], InputForm], "`"]];
webHeadName[h_] := If[Head[Unevaluated[h]] === Symbol,
  webSymbolName[Unevaluated[h]], ToString[Unevaluated[h], InputForm]];

webMatrixData[m_] := Module[{sparse, dimensions, rules, entries},
  sparse = SparseArray[m];
  dimensions = Dimensions[sparse];
  rules = Select[ArrayRules[sparse], MatchQ[First[#], {_Integer, _Integer}] &];
  entries = Map[
    Function[rule, <|
      "index" -> (First[rule] - 1),
      "value" -> WebExpressionData[Last[rule]]
    |>],
    SortBy[rules, First]
  ];
  <|"kind" -> "sparseMatrix", "dimensions" -> dimensions,
    "indexBase" -> 0, "entries" -> entries|>
];

WebExpressionData[expr_?MatrixQ] := webMatrixData[expr];
WebExpressionData[expr_Integer] := <|
  "kind" -> "integer", "value" -> ToString[expr, InputForm]|>;
WebExpressionData[expr_Rational] := <|
  "kind" -> "rational",
  "numerator" -> ToString[Numerator[expr], InputForm],
  "denominator" -> ToString[Denominator[expr], InputForm]|>;
WebExpressionData[expr_Real] := Module[{precision = Precision[expr]},
  <|"kind" -> "real", "value" -> ToString[expr, InputForm],
    "precision" -> If[NumericQ[precision], N[precision], Null]|>
];
WebExpressionData[expr_Complex] := <|
  "kind" -> "complex",
  "real" -> WebExpressionData[Re[expr]],
  "imaginary" -> WebExpressionData[Im[expr]]|>;
WebExpressionData[expr_String] := <|"kind" -> "string", "value" -> expr|>;
WebExpressionData[expr_Symbol] := <|
  "kind" -> "symbol", "name" -> webSymbolName[Unevaluated[expr]]|>;
WebExpressionData[expr_] := <|
  "kind" -> "call", "head" -> webHeadName[Head[Unevaluated[expr]]],
  "arguments" -> (WebExpressionData /@ List @@ expr)|>;

webNullable[value_] := If[MissingQ[value], Null, value];
webExpressionAssociation[association_Association] := Association@KeyValueMap[
  ToString[#1] -> WebExpressionData[#2] &, association];
webExpressionAssociation[_] := <||>;

webJSONSafe[value_Association] := Association@KeyValueMap[
  ToString[#1] -> webJSONSafe[#2] &, value];
webJSONSafe[value_List] := webJSONSafe /@ value;
webJSONSafe[value_?MissingQ] := Null;
webJSONSafe[value_Rational] := N[value];
webJSONSafe[value_Complex] := ToString[value, InputForm];
webJSONSafe[value_Symbol] := webSymbolName[Unevaluated[value]];
webJSONSafe[value_ /; StringQ[value] || IntegerQ[value] || RealValuedNumberQ[value] ||
    TrueQ[value] || FalseQ[value] || value === Null] := value;
webJSONSafe[value_] := ToString[value, InputForm];

webSlug[value_] := StringTrim[StringReplace[ToLowerCase[ToString[value]], {
  "*" -> "star", "(" -> "-", ")" -> "", "+" -> "plus",
  " " -> "-", "/" -> "-", "." -> "-", "_" -> "-"
}], "-"];
webIntegerListSlug[{}] := "none";
webIntegerListSlug[values_List] := StringRiffle[ToString /@ values, "-"];
webDiagramID[d_Association] := StringRiffle[{
  webSlug[d["AffineType"]], "n" <> ToString[d["Rank"]],
  "x" <> webIntegerListSlug[d["X"]],
  "tau" <> webIntegerListSlug[d["Tau"]]
}, "--"];

webBasisLabel[value_Integer] := value;
webBasisLabel[value_String] := value;
webBasisLabel[value_] := ToString[value, InputForm];

webMatrixLatex[matrix_] := Block[
  {$ContextPath = DeleteDuplicates[Join[{"QREKMatrices`Private`"}, $ContextPath]]},
  ToString[TeXForm[MatrixForm[Normal[matrix]]]]
];

webSolutionData[result_Association, diagramID_String, ordinal_Integer : 1] /;
    KeyExistsQ[result, "KMatrix"] := Module[
  {matrix = result["KMatrix"], family, equation, basis, params, provenance},
  family = ToString[Lookup[result, "Family", "Unspecified"]];
  equation = ToString[Lookup[result, "Equation", "Standard"]];
  basis = webBasisLabel /@ Lookup[result, "BasisLabels", Range[Length[matrix]]];
  params = webExpressionAssociation[Lookup[result, "Parameters", <||>]];
  provenance = webJSONSafe[Lookup[result, "Provenance", <||>]];
  <|
    "solutionId" -> StringRiffle[{diagramID, webSlug[family], ToString[ordinal]}, "--"],
    "family" -> family,
    "equation" -> equation,
    "realization" -> "bare",
    "transformations" -> {},
    "basisLabels" -> basis,
    "parameters" -> params,
    "matrix" -> webMatrixData[matrix],
    "latex" -> webMatrixLatex[matrix],
    "provenance" -> provenance,
    "properties" -> {}
  |>
];

webComputationData[row_Association, diagramID_String, include_] := Module[
  {result, solution = Null, candidates = {}, status},
  If[!TrueQ[include], Return[<|
    "status" -> "NotRequested", "solution" -> Null, "candidates" -> {}|>]];
  result = row["Result"];
  status = ToString[row["Status"]];
  If[AssociationQ[result] && KeyExistsQ[result, "KMatrix"],
    solution = webSolutionData[result, diagramID]
  ];
  If[AssociationQ[result] && KeyExistsQ[result, "Candidates"],
    candidates = MapIndexed[
      Function[{candidate, index},
        If[AssociationQ[candidate] && AssociationQ[Lookup[candidate, "Result", None]] &&
            KeyExistsQ[candidate["Result"], "KMatrix"],
          webSolutionData[candidate["Result"], diagramID, First[index]], Nothing]
      ],
      result["Candidates"]
    ]
  ];
  <|"status" -> status, "solution" -> solution, "candidates" -> candidates|>
];

webClassificationData[classification_Association] := <|
  "status" -> ToString[classification["ClassificationStatus"]],
  "family" -> webNullable[classification["Family"]],
  "candidateFamilies" -> (ToString /@ classification["CandidateFamilies"]),
  "regime" -> ToString[classification["Regime"]],
  "equation" -> ToString[classification["Equation"]],
  "parameters" -> webExpressionAssociation[classification["Parameters"]],
  "representativeFamily" -> webNullable[
    Lookup[classification, "RepresentativeFamily", Missing[]]],
  "representativePermutation" -> webNullable[
    Lookup[classification, "RepresentativePermutation", Missing[]]]
|>;

Options[WebCatalogueData] = {
  "IncludeKMatrices" -> False,
  "QuantumParameter" -> q
};
WebCatalogueData[type_String, n_Integer, OptionsPattern[]] := Module[
  {canonical = canonicalType[type], diagrams, rows, include,
   records, statuses, catalogueID, ambient, rMatrixID},
  If[MissingQ[canonical], Return[$Failed]];
  If[Quiet[CartanMatrixOf[canonical, n]] === $Failed, Return[$Failed]];
  include = TrueQ[OptionValue["IncludeKMatrices"]];
  diagrams = GeneralizedSatakeDiagrams[canonical, n];
  If[diagrams === $Failed, Return[$Failed]];
  rows = If[include,
    KMatrixTable[canonical, n, u,
      "QuantumParameter" -> OptionValue["QuantumParameter"]],
    Map[Function[diagram, <|
      "Diagram" -> diagram,
      "Classification" -> ClassifySatakeDiagram[diagram],
      "Status" -> "NotRequested",
      "Result" -> Null|>], diagrams]
  ];
  catalogueID = webSlug[canonical] <> "--n" <> ToString[n];
  ambient = AmbientRMatrixData[canonical, n];
  If[!AssociationQ[ambient], Return[$Failed]];
  rMatrixID = ambient["rMatrix", "rMatrixId"];
  records = Map[
    Function[row, Module[{diagram = row["Diagram"], classification,
      diagramID, computation},
      classification = row["Classification"];
      diagramID = webDiagramID[diagram];
      computation = webComputationData[row, diagramID, include];
      <|
        "id" -> diagramID,
        "spec" -> <|
          "affineType" -> diagram["AffineType"], "rank" -> diagram["Rank"],
          "nodes" -> diagram["Nodes"], "X" -> diagram["X"],
          "tau" -> diagram["Tau"]|>,
        "data" -> <|
          "cartanMatrix" -> Normal[diagram["CartanMatrix"]],
          "symmetrizers" -> (WebExpressionData /@
            SymmetrizersOf[diagram["AffineType"], diagram["Rank"]])
        |>,
        "classification" -> webClassificationData[classification],
        "qsp" -> QSPPresentationData[diagram],
        "reflectionEquation" -> ReflectionEquationData[diagram, rMatrixID],
        "capabilities" -> <|
          "qspAlgebra" -> True,
          "kMatrix" -> (computation["solution"] =!= Null ||
            computation["candidates"] =!= {}),
          "rMatrix" -> True,
          "properties" -> {},
          "remoteComputation" -> False|>,
        "computation" -> computation
      |>
    ]],
    rows
  ];
  statuses = If[records === {}, <||>,
    Counts[Lookup[Lookup[records, "computation"], "status"]]];
  <|
    "schemaVersion" -> $webCatalogueSchemaVersion,
    "engine" -> <|"name" -> "QREKMatrices", "version" -> $qreKMatricesVersion|>,
    "catalogue" -> <|"id" -> catalogueID, "affineType" -> canonical,
      "rank" -> n|>,
    "ambient" -> ambient,
    "summary" -> <|"diagramCount" -> Length[records],
      "statuses" -> statuses|>,
    "diagrams" -> records
  |>
];

Options[ExportWebCatalogue] = {
  "Types" -> Automatic,
  "Ranks" -> {3},
  "IncludeKMatrices" -> False,
  "QuantumParameter" -> q
};
ExportWebCatalogue[path_String, OptionsPattern[]] := Module[
  {types, ranks, outputDirectory, files = {}, data, filename, manifest},
  types = Replace[OptionValue["Types"], Automatic -> AffineTypes[]];
  ranks = OptionValue["Ranks"];
  If[!ListQ[types] || !ListQ[ranks], Return[$Failed]];
  outputDirectory = ExpandFileName[path];
  If[!DirectoryQ[outputDirectory],
    CreateDirectory[outputDirectory, CreateIntermediateDirectories -> True]];
  Do[
    data = Quiet[WebCatalogueData[type, rank,
      "IncludeKMatrices" -> OptionValue["IncludeKMatrices"],
      "QuantumParameter" -> OptionValue["QuantumParameter"]]];
    If[AssociationQ[data] && data["summary", "diagramCount"] > 0,
      filename = data["catalogue", "id"] <> ".json";
      Export[FileNameJoin[{outputDirectory, filename}], data, "RawJSON"];
      AppendTo[files, <|
        "id" -> data["catalogue", "id"],
        "affineType" -> data["catalogue", "affineType"],
        "rank" -> data["catalogue", "rank"],
        "path" -> filename,
        "diagramCount" -> data["summary", "diagramCount"]|>]
    ],
    {type, types}, {rank, ranks}
  ];
  manifest = <|
    "schemaVersion" -> $webCatalogueSchemaVersion,
    "engine" -> <|"name" -> "QREKMatrices", "version" -> $qreKMatricesVersion|>,
    "files" -> Flatten[files]
  |>;
  Export[FileNameJoin[{outputDirectory, "manifest.json"}], manifest, "RawJSON"];
  manifest
];

End[];
EndPackage[];
