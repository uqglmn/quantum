KMatrixFamilies[type_String] := Module[{canonical = canonicalType[type]},
  If[MissingQ[canonical], Return[$Failed]];
  Keys@Select[$familyRegistry, MemberQ[Lookup[#, "AffineTypes", {}], canonical] &]
];
KMatrixFamilyData[family_String] := Module[{record = Lookup[$familyRegistry,
    family, Missing["UnknownFamily", family]]},
  If[MissingQ[record], Return[record]];
  Join[<|"FamilyID" -> family, "Title" -> family|>, record]
];

zeroCartan[n_Integer] := 2 IdentityMatrix[n + 1];
setEdge[a_, i_Integer, j_Integer, aij_Integer, aji_Integer] := Module[{b = a},
  b[[i + 1, j + 1]] = aij;
  b[[j + 1, i + 1]] = aji;
  b
];

CartanMatrixOf::type = "Unknown supported affine type `1`.";
CartanMatrixOf::rank = "The rank parameter n=`1` is not supported for type `2`.";

CartanMatrixOf[type_, n_Integer] := Module[{t = canonicalType[type], a, i},
  If[MissingQ[t], Message[CartanMatrixOf::type, type]; Return[$Failed]];
  Switch[t,
    "A(1)",
      If[n < 1, Message[CartanMatrixOf::rank, n, t]; Return[$Failed]];
      If[n == 1, Return[{{2, -2}, {-2, 2}}]];
      a = zeroCartan[n];
      Do[a = setEdge[a, i, i + 1, -1, -1], {i, 0, n - 1}];
      setEdge[a, n, 0, -1, -1],
    "B(1)",
      If[n < 2, Message[CartanMatrixOf::rank, n, t]; Return[$Failed]];
      a = zeroCartan[n];
      a = setEdge[a, 0, 2, -1, If[n == 2, -2, -1]];
      a = setEdge[a, 1, 2, -1, -1];
      Do[a = setEdge[a, i, i + 1, -1, -1], {i, 2, n - 2}];
      setEdge[a, n - 1, n, -1, -2],
    "C(1)",
      If[n < 2, Message[CartanMatrixOf::rank, n, t]; Return[$Failed]];
      a = zeroCartan[n];
      a = setEdge[a, 0, 1, -1, -2];
      Do[a = setEdge[a, i, i + 1, -1, -1], {i, 1, n - 2}];
      setEdge[a, n - 1, n, -2, -1],
    "D(1)",
      If[n < 4, Message[CartanMatrixOf::rank, n, t]; Return[$Failed]];
      a = zeroCartan[n];
      a = setEdge[a, 0, 2, -1, -1];
      a = setEdge[a, 1, 2, -1, -1];
      Do[a = setEdge[a, i, i + 1, -1, -1], {i, 2, n - 3}];
      a = setEdge[a, n - 2, n - 1, -1, -1];
      setEdge[a, n - 2, n, -1, -1],
    "A2n-1(2)",
      If[n < 3, Message[CartanMatrixOf::rank, n, t]; Return[$Failed]];
      a = zeroCartan[n];
      a = setEdge[a, 0, 2, -1, -1];
      a = setEdge[a, 1, 2, -1, -1];
      Do[a = setEdge[a, i, i + 1, -1, -1], {i, 2, n - 2}];
      setEdge[a, n - 1, n, -2, -1],
    "A2n-1(2)T",
      Reverse[Reverse[CartanMatrixOf["A2n-1(2)", n]], 2],
    "A2n(2)",
      If[n < 1, Message[CartanMatrixOf::rank, n, t]; Return[$Failed]];
      If[n == 1, Return[{{2, -1}, {-4, 2}}]];
      a = zeroCartan[n];
      a = setEdge[a, 0, 1, -1, -2];
      Do[a = setEdge[a, i, i + 1, -1, -1], {i, 1, n - 2}];
      setEdge[a, n - 1, n, -1, -2],
    "A2n(2)T",
      Reverse[Reverse[CartanMatrixOf["A2n(2)", n]], 2],
    "Dn+1(2)",
      If[n < 1, Message[CartanMatrixOf::rank, n, t]; Return[$Failed]];
      If[n == 1, Return[{{2, -2}, {-2, 2}}]];
      a = zeroCartan[n];
      a = setEdge[a, 0, 1, -2, -1];
      Do[a = setEdge[a, i, i + 1, -1, -1], {i, 1, n - 2}];
      setEdge[a, n - 1, n, -1, -2]
  ]
];
CartanMatrixOf[type_, n_] := (Message[CartanMatrixOf::rank, n, type]; $Failed);

SymmetrizersOf[type_, n_Integer] := Module[{t = canonicalType[type]},
  If[MissingQ[t] || CartanMatrixOf[t, n] === $Failed, Return[$Failed]];
  Switch[t,
    "A(1)" | "D(1)", ConstantArray[1, n + 1],
    "B(1)", ReplacePart[ConstantArray[1, n + 1], n + 1 -> 1/2],
    "C(1)", ReplacePart[ConstantArray[1, n + 1], {1 -> 2, n + 1 -> 2}],
    "A2n-1(2)", ReplacePart[ConstantArray[1, n + 1], n + 1 -> 2],
    "A2n-1(2)T", ReplacePart[ConstantArray[1, n + 1], 1 -> 2],
    "A2n(2)", ReplacePart[ConstantArray[1, n + 1], {1 -> 2, n + 1 -> 1/2}],
    "A2n(2)T", ReplacePart[ConstantArray[1, n + 1], {1 -> 1/2, n + 1 -> 2}],
    "Dn+1(2)", ReplacePart[ConstantArray[1, n + 1], {1 -> 1/2, n + 1 -> 1/2}]
  ]
];

simpleReflection[a_, i_Integer] := Module[{s = IdentityMatrix[Length[a]]},
  s[[i + 1, All]] = s[[i + 1, All]] - a[[i + 1, All]];
  s
];

positiveRootQ[v_List] := And @@ Thread[v >= 0] && AnyTrue[v, Positive];

LongestParabolicElement::nodes = "X=`1` is not a set of nodes for a matrix of size `2`.";
LongestParabolicElement::finite = "The parabolic subsystem on X=`1` did not terminate as finite type.";

Options[LongestParabolicElement] = {"MaximumLength" -> 100000};
longestParabolicData[a_?MatrixQ, x_List, max_Integer] := Module[
  {r = Length[a], nodes = Sort@DeleteDuplicates[x], w, candidates, steps = 0, word = {}},
  If[Dimensions[a] =!= {r, r} || !SubsetQ[Range[0, r - 1], nodes],
    Message[LongestParabolicElement::nodes, x, r]; Return[$Failed]
  ];
  w = IdentityMatrix[r];
  While[
    candidates = Select[nodes, positiveRootQ[w[[All, # + 1]]] &];
    candidates =!= {},
    AppendTo[word, First[candidates]];
    w = w . simpleReflection[a, Last[word]];
    steps++;
    If[steps > max,
      Message[LongestParabolicElement::finite, nodes]; Return[$Failed]
    ]
  ];
  <|"Element" -> w, "Word" -> word, "Length" -> steps|>
];

LongestParabolicElement[a_?MatrixQ, x_List, OptionsPattern[]] := Module[{data},
  data = longestParabolicData[a, x, OptionValue["MaximumLength"]];
  If[AssociationQ[data], data["Element"], data]
];

Options[LongestParabolicWord] = Options[LongestParabolicElement];
LongestParabolicWord[a_?MatrixQ, x_List, OptionsPattern[]] := Module[{data},
  data = longestParabolicData[a, x, OptionValue["MaximumLength"]];
  If[AssociationQ[data], data["Word"], data]
];

normaliseTau[tau_, n_Integer] := Which[
  tau === Automatic, Range[0, n],
  AssociationQ[tau], Lookup[tau, Range[0, n], Missing["UnspecifiedImage"]],
  ListQ[tau], tau,
  True, $Failed
];

inducedComponents[a_, x_List] := Module[{edges},
  If[x === {}, Return[{}]];
  edges = UndirectedEdge @@@ Select[Subsets[x, {2}],
    a[[#[[1]] + 1, #[[2]] + 1]] != 0 || a[[#[[2]] + 1, #[[1]] + 1]] != 0 &
  ];
  ConnectedComponents[Graph[x, edges]]
];

generalizedSatakeExclusions[a_, x_List, p_List] := Module[
  {components = inducedComponents[a, x], bad = {}, adjacentComponents, black},
  Do[
    If[p[[i + 1]] == i,
      adjacentComponents = Select[components,
        AnyTrue[#, a[[i + 1, # + 1]] != 0 || a[[# + 1, i + 1]] != 0 &] &
      ];
      black = Union @@ adjacentComponents;
      If[Length[black] == 1 &&
          a[[i + 1, First[black] + 1]] == -1 &&
          a[[First[black] + 1, i + 1]] == -1,
        AppendTo[bad, {i, First[black]}]
      ]
    ],
    {i, Complement[Range[0, Length[a] - 1], x]}
  ];
  bad
];

diagramDiagnostics[type_, n_Integer, x_List, tau_] := Module[
  {t = canonicalType[type], a, nodes = Range[0, n], p, wx, errors = {}, compatible, exclusions},
  If[MissingQ[t], Return[{"Unknown affine type"}]];
  a = Quiet[CartanMatrixOf[t, n]];
  If[a === $Failed, Return[{"Unsupported rank for affine type"}]];
  If[!DuplicateFreeQ[x], AppendTo[errors, "X contains duplicate nodes"]];
  If[!SubsetQ[nodes, x], AppendTo[errors, "X is not a subset of 0,...,n"]];
  p = normaliseTau[tau, n];
  If[p === $Failed || Length[p] =!= n + 1 || !PermutationListQ[p + 1],
    AppendTo[errors, "tau is not a permutation of 0,...,n"];
    Return[errors]
  ];
  If[p[[p + 1]] =!= nodes, AppendTo[errors, "tau is not involutive"]];
  If[Sort[p[[x + 1]]] =!= Sort[x], AppendTo[errors, "tau does not preserve X"]];
  If[a[[p + 1, p + 1]] =!= a, AppendTo[errors, "tau is not a Cartan diagram automorphism"]];
  If[errors === {},
    wx = Quiet[LongestParabolicElement[a, x]];
    If[wx === $Failed,
      AppendTo[errors, "the parabolic subsystem on X is not verified finite"],
      compatible = And @@ Table[
        -wx[[All, i + 1]] === UnitVector[n + 1, p[[i + 1]] + 1],
        {i, x}
      ];
      If[!compatible, AppendTo[errors, "tau|X does not equal the opposition involution -w_X"]]
    ]
  ];
  If[errors === {},
    exclusions = generalizedSatakeExclusions[a, x, p];
    If[exclusions =!= {},
      AppendTo[errors,
        "forbidden isolated white--black A2 component(s): " <> ToString[exclusions, InputForm]
      ]
    ]
  ];
  errors
];

CreateSatakeDiagram::invalid = "Invalid generalized Satake diagram: `1`.";
CreateSatakeDiagram[type_, n_Integer, x_List, tau_: Automatic] := Module[
  {t = canonicalType[type], p, diagnostics, a},
  diagnostics = diagramDiagnostics[type, n, x, tau];
  If[diagnostics =!= {},
    Message[CreateSatakeDiagram::invalid, StringRiffle[diagnostics, "; "]];
    Return[Failure["InvalidSatakeDiagram", <|"Diagnostics" -> diagnostics|>]]
  ];
  p = normaliseTau[tau, n];
  a = CartanMatrixOf[t, n];
  <|
    "ObjectType" -> "GeneralizedSatakeDiagram",
    "AffineType" -> t,
    "Rank" -> n,
    "Nodes" -> Range[0, n],
    "X" -> Sort[x],
    "Tau" -> p,
    "CartanMatrix" -> a,
    "LongestParabolicElement" -> LongestParabolicElement[a, x],
    "ValidationLevel" -> "GeneralizedSatakeDefinition",
    "Diagnostics" -> {}
  |>
];

SatakeDiagramQ[d_] := AssociationQ[d] &&
  Lookup[d, "ObjectType", None] === "GeneralizedSatakeDiagram" &&
  Lookup[d, "Diagnostics", {"invalid"}] === {};

SatakeDiagramData[d_?SatakeDiagramQ] := d;
SatakeDiagramData[d_?SatakeDiagramQ, key_] := Lookup[d, key, Missing["UnknownProperty", key]];

cyclicRotationQ[p_List] := Module[{size = Length[p], nodes, shift},
  nodes = Range[0, size - 1];
  shift = First[p];
  p === Mod[nodes + shift, size]
];

BoundaryEquationType[d_?SatakeDiagramQ] := Module[
  {type = d["AffineType"], n = d["Rank"], tau = d["Tau"]},
  Which[
    type === "A(1)" && n > 1 && cyclicRotationQ[tau], "Transposed",
    True, "Standard"
  ]
];

$plainFamilies = <|"B(1)" -> "B.1", "C(1)" -> "C.1",
  "D(1)" -> "D.1", "A2n-1(2)" -> "B*.1",
  "A2n-1(2)T" -> "tB*.1", "A2n(2)" -> "C**.1",
  "A2n(2)T" -> "tC**.1", "Dn+1(2)" -> "C*.1"|>;
$alternatingFamilies = <|"B(1)" -> "B.2", "C(1)" -> "C.2",
  "D(1)" -> "D.2", "A2n-1(2)" -> "B*.2",
  "A2n-1(2)T" -> "tB*.2", "A2n(2)" -> "C**.2",
  "A2n(2)T" -> "tC**.2", "Dn+1(2)" -> "C*.2"|>;
$parallelFamilies = <|"C(1)" -> "C.4", "D(1)" -> "D.4",
  "Dn+1(2)" -> "C*.4"|>;

inversePermutation[p_List] := Ordering[p] - 1;
conjugatePermutation[tau_List, sigma_List] := Module[{inverse},
  inverse = inversePermutation[sigma];
  sigma[[tau[[inverse + 1]] + 1]]
];

diagramImageData[d_?SatakeDiagramQ, sigma_List] := <|
  "X" -> Sort[sigma[[d["X"] + 1]]],
  "Tau" -> conjugatePermutation[d["Tau"], sigma],
  "Permutation" -> sigma
|>;

identityTypeTauQ[type_String, n_Integer, tau_List] := Module[
  {nodes = Range[0, n]},
  Switch[type,
    "C(1)" | "Dn+1(2)", tau === nodes,
    "D(1)", Sort[tau[[{1, 2}]]] === {0, 1} &&
      Sort[tau[[{n, n + 1}]]] === {n - 1, n},
    _, True
  ]
];

whiteOrbitRepresentativeSets[white_List, tau_List] := Module[{orbits},
  orbits = DeleteDuplicates[Sort /@ ({#, tau[[# + 1]]} & /@ white)];
  DeleteDuplicates[Sort /@ Tuples[orbits]]
];

identityFamilyMatches[type_String, n_Integer, image_Association] := Module[
  {nodes = Range[0, n], white, representatives, ell, r, matches = {},
   tau = image["Tau"], sigma = image["Permutation"], plain, alternating,
   regime, iStar, plainCompatible, plainTransport},
  white = Complement[nodes, image["X"]];
  If[white === {} || !identityTypeTauQ[type, n, tau], Return[{}]];
  representatives = whiteOrbitRepresentativeSets[white, tau];
  plain = Lookup[$plainFamilies, type, Missing["NoPlainFamily"]];
  alternating = Lookup[$alternatingFamilies, type, Missing["NoAlternatingFamily"]];
  Do[
    iStar = reps;
    ell = Min[iStar]; r = Max[iStar];
    regime = If[Length[iStar] == 3 && r - ell == 2,
      "NonQuasistandard", "MainCatalogue"];
    {plainCompatible, plainTransport} = Switch[type,
      "A2n-1(2)",
        Which[
          tau[[{1, 2}]] === {0, 1}, {EvenQ[ell], False},
          tau[[{1, 2}]] === {1, 0}, {OddQ[ell], True},
          True, {False, False}
        ],
      "A2n-1(2)T",
        Which[
          tau[[{n, n + 1}]] === {n - 1, n}, {EvenQ[n - r], False},
          tau[[{n, n + 1}]] === {n, n - 1}, {OddQ[n - r], True},
          True, {False, False}
        ],
      _, {True, False}
    ];
    If[StringQ[plain] && plainCompatible && iStar === Range[ell, r],
      AppendTo[matches, <|"Family" -> plain,
        "Parameters" -> <|"l" -> ell, "r" -> r|>,
        "Regime" -> If[regime === "MainCatalogue" && plainTransport,
          "FormulaTransportPending", regime],
        "IStar" -> iStar, "RepresentativePermutation" -> sigma|>]
    ];
    If[StringQ[alternating] && iStar === Range[ell, r, 2],
      AppendTo[matches, <|"Family" -> alternating,
        "Parameters" -> <|"l" -> ell, "r" -> r|>,
        "Regime" -> If[type === "Dn+1(2)" && ell < r,
          "WeakAlternating", "MainCatalogue"],
        "IStar" -> iStar, "RepresentativePermutation" -> sigma|>]
    ],
    {reps, representatives}
  ];
  DeleteDuplicatesBy[matches, {#["Family"], #["Parameters"]} &]
];

parallelFamilyMatches[type_String, n_Integer, image_Association] := Module[
  {nodes = Range[0, n], family, ell, expectedX, tau = image["Tau"],
   sigma = image["Permutation"]},
  family = Lookup[$parallelFamilies, type, Missing["NoParallelFamily"]];
  If[!StringQ[family] || tau =!= Reverse[nodes], Return[{}]];
  ell = If[image["X"] === {}, Floor[n/2], Min[image["X"]] - 1];
  If[ell < 0 || ell > Floor[n/2], Return[{}]];
  expectedX = Range[ell + 1, n - ell - 1];
  If[image["X"] =!= expectedX, Return[{}]];
  {<|"Family" -> family, "Parameters" -> <|"l" -> ell|>,
    "Regime" -> "MainCatalogue", "RepresentativePermutation" -> sigma|>}
];

exceptionalD4Matches[type_String, n_Integer, image_Association] := Module[
  {moved},
  If[type =!= "D(1)" || n =!= 4, Return[{}]];
  moved = Count[MapThread[Unequal, {Range[0, n], image["Tau"]}], True];
  If[moved =!= 2 || identityTypeTauQ[type, n, image["Tau"]], Return[{}]];
  {<|"Family" -> "D.3", "Parameters" -> <||>,
    "Regime" -> "NoVectorKMatrix",
    "RepresentativePermutation" -> image["Permutation"]|>}
];

ClassifySatakeDiagram[d_?SatakeDiagramQ] := Module[
  {type = d["AffineType"], n = d["Rank"], x = d["X"], tau = d["Tau"],
   size, nodes, identity, halfRotation, family, params = <||>, t, whiteHalf,
   candidates = {}, orbitCandidates = {}, status = "ClassifierPending", equation,
   images, matches, a3Matches,
   directMatches, chosen = <||>, representativeFamily = Missing["NotAvailable"],
   regime = "MainCatalogue"},
  size = n + 1;
  nodes = Range[0, n];
  identity = nodes;
  equation = BoundaryEquationType[d];
  If[type === "A(1)",
    halfRotation = If[EvenQ[size], Mod[nodes + size/2, size], None];
    Which[
      tau === identity && x === {}, family = "A.1"; status = "Classified",
      tau === identity, family = "A.2"; status = "Classified",
      EvenQ[size] && tau === halfRotation && x === {},
        family = "A.4"; status = "Classified",
      !cyclicRotationQ[tau],
        images = diagramImageData[d, #] & /@ dihedralAutomorphisms[size];
        a3Matches = DeleteCases[Map[Function[image,
          t = If[First[image["Tau"]] == 0, size, First[image["Tau"]]];
          whiteHalf = Complement[Range[0, Floor[t/2]], image["X"]];
          If[MemberQ[{size - 1, size}, t] && whiteHalf =!= {},
            <|"Family" -> "A.3", "Parameters" -> <|
                "l" -> Min[whiteHalf], "r" -> Max[whiteHalf], "t" -> t|>,
              "RepresentativePermutation" -> image["Permutation"]|>,
            Nothing]], images], Nothing];
        If[a3Matches =!= {},
          chosen = SelectFirst[a3Matches,
            #["RepresentativePermutation"] === identity &, First[a3Matches]];
          params = chosen["Parameters"];
          candidates = {"A.3"}; orbitCandidates = {"A.3"};
          representativeFamily = "A.3";
          If[chosen["RepresentativePermutation"] === identity,
            family = "A.3"; status = "Classified",
            family = Missing["RequiresDiagramAutomorphism", "A.3"];
            status = "ClassifiedUpToDiagramAutomorphism"],
          family = "A.3"; candidates = {"A.3"};
          status = "ParameterExtractionFailed"
        ],
      True, family = Missing["UnclassifiedFamily"]
    ];
    If[StringQ[family] && candidates === {}, candidates = {family}],
    images = diagramImageData[d, #] & /@ diagramAutomorphisms[type, n];
    matches = Flatten[Join[
      identityFamilyMatches[type, n, #], parallelFamilyMatches[type, n, #],
      exceptionalD4Matches[type, n, #]] & /@ images, 1];
    If[AnyTrue[matches, #["Family"] === "D.3" &&
        #["RepresentativePermutation"] === identity &],
      matches = Select[matches, #["Family"] === "D.3" &]
    ];
    matches = DeleteDuplicatesBy[matches,
      {#["Family"], #["Parameters"], #["Regime"]} &];
    orbitCandidates = DeleteDuplicates[Lookup[matches, "Family", {}]];
    directMatches = Select[matches,
      #["RepresentativePermutation"] === identity &];
    candidates = If[directMatches =!= {},
      DeleteDuplicates[Lookup[directMatches, "Family", {}]], orbitCandidates];
    chosen = Which[directMatches =!= {}, First[directMatches],
      matches =!= {}, First[matches], True, <||>];
    If[chosen =!= <||>,
      params = chosen["Parameters"];
      regime = chosen["Regime"];
      representativeFamily = chosen["Family"],
      regime = "Unclassified"
    ];
    Which[
      Length[candidates] == 1 && directMatches =!= {},
        family = First[candidates];
        status = Switch[regime,
          "NonQuasistandard", "ClassifiedNonQuasistandard",
          "FormulaTransportPending", "ClassifiedFormulaTransportPending",
          _, "Classified"
        ],
      Length[candidates] == 1,
        family = Missing["RequiresDiagramAutomorphism", First[candidates]];
        status = "ClassifiedUpToDiagramAutomorphism",
      Length[candidates] > 1,
        family = Missing["AmbiguousFamily", candidates];
        status = "CandidateFamiliesOnly",
      True,
        family = Missing["UnclassifiedFamily"];
        status = "ClassifierPending"
    ]
  ];
  <|"Family" -> family, "CandidateFamilies" -> candidates,
    "OrbitCandidateFamilies" -> orbitCandidates,
    "Parameters" -> params, "Equation" -> equation,
    "ClassificationStatus" -> status, "Regime" -> regime,
    "RepresentativeFamily" -> representativeFamily,
    "RepresentativePermutation" -> Lookup[chosen, "RepresentativePermutation",
      Missing["NotAvailable"]],
    "CatalogueEntry" -> If[StringQ[family],
      Lookup[$catalogue, family, Missing["UnknownFamily"]], Missing["NotUniquelyClassified"]],
    "CatalogueEntries" -> AssociationMap[
      Lookup[$catalogue, #, Missing["UnknownFamily"]] &, candidates]|>
];

nonQuasiEndpointQ[family_, n_, ell_, r_] := Switch[family,
  "B.1", MemberQ[{{0, 2}, {n - 1, n}}, {ell, r}],
  "D.1", {ell, r} === {0, 2},
  "B*.1", {ell, r} === {0, 2},
  "C**.1", {ell, r} === {n - 1, n},
  "tC**.1" | "C*.1", {ell, r} === {0, 1},
  _, False
];

supportedNonQuasiFormulaQ[family_, n_, ell_, r_] :=
  IntegerQ[n] && IntegerQ[ell] && IntegerQ[r] &&
    (nonQuasiEndpointQ[family, n, ell, r] ||
      (r === ell + 2 && Switch[family,
        "C.1", 1 <= ell <= n - 3,
        "B.1" | "D.1", 1 <= ell <= n - 2,
        "B*.1" | "tB*.1", 1 <= ell <= n - 3,
        "C**.1" | "tC**.1", 1 <= ell <= n - 2,
        "C*.1", 0 <= ell <= n - 2,
        _, False
      ]));

nonQuasiParameterRequestQ[family_, n_, ell_, r_, params_Association] :=
  supportedNonQuasiFormulaQ[family, n, ell, r] && Switch[family,
    "B.1" | "D.1", KeyExistsQ[params, "Nu"] ||
      KeyExistsQ[params, "Nu0"] || KeyExistsQ[params, "Nu1"],
    "B*.1", KeyExistsQ[params, "Nu0"] || KeyExistsQ[params, "Nu1"],
    "C.1" | "C**.1" | "tC**.1" | "C*.1", KeyExistsQ[params, "Nu"],
    _, False
  ];

CanonicalCoidealParameters::family = "Canonical coideal parameters are not yet encoded for candidate family or families `1`.";
Options[CanonicalCoidealParameters] = {
  "Method" -> Automatic,
  "Parameters" -> <||>,
  "ScalingParameter" -> 1,
  "SNodes" -> Automatic
};
CanonicalCoidealParameters[d_?SatakeDiagramQ, q_: q, OptionsPattern[]] := Module[
  {classification = ClassifySatakeDiagram[d], family, outside, c, method,
   spectral, matrixResult, inferred, chosen, supportedNonQuasi, params, ell, r,
   nu, eta},
  family = classification["Family"];
  outside = Complement[d["Nodes"], d["X"]];
  params = Join[Lookup[classification, "Parameters", <||>],
    OptionValue["Parameters"]];
  ell = Lookup[params, "l", Missing[]];
  r = Lookup[params, "r", Missing[]];
  supportedNonQuasi = supportedNonQuasiFormulaQ[family, d["Rank"], ell, r] &&
    (Lookup[classification, "Regime", None] === "NonQuasistandard" ||
      Lookup[params, "Regime", None] === "NonQuasistandard" ||
      nonQuasiParameterRequestQ[family, d["Rank"], ell, r, params]);
  method = OptionValue["Method"];
  If[method === Automatic,
    method = If[(MemberQ[{"A.1", "A.2", "A.4"}, family] &&
          OptionValue["ScalingParameter"] === 1) ||
        (family === "C**.1" && nonQuasiEndpointQ[family, d["Rank"], ell, r] &&
          TrueQ[supportedNonQuasi]),
      "SourceAssignment", "BoundaryInference"]
  ];
  If[method === "SourceAssignment" && family === "C**.1" &&
      nonQuasiEndpointQ[family, d["Rank"], ell, r] && TrueQ[supportedNonQuasi],
    nu = Lookup[params, "Nu", Symbol["\[Nu]"]];
    eta = OptionValue["ScalingParameter"];
    Return[<|"Family" -> family,
      "CParameters" -> <|d["Rank"] - 1 -> (-q)^(d["Rank"] - 1) eta^-1,
        d["Rank"] -> -I|>,
      "SParameters" -> <|d["Rank"] - 1 -> 0,
        d["Rank"] -> (-1)^(3/4) q^(1/4) (nu + nu^-1)/
          (q^(1/2) - q^(-1/2))|>,
      "ScalingParameter" -> eta, "Equation" -> classification["Equation"],
      "DressingParameters" -> <||>, "BoundaryParameters" -> params,
      "ResearchStatus" -> "BareAssignmentFromqREII"|>]
  ];
  Switch[method,
    "SourceAssignment",
      c = Switch[family,
        "A.1", Association@Table[i -> 1, {i, outside}],
        "A.2", Association@Table[i -> q^3, {i, outside}],
        "A.4", Association@Table[i -> q, {i, outside}],
        _, Message[CanonicalCoidealParameters::family,
          classification["CandidateFamilies"]];
          Return[Failure["CanonicalSourceAssignmentNotImplemented", classification]]
      ];
      <|"Family" -> family, "CParameters" -> c,
        "SParameters" -> Association@Table[i -> 0, {i, outside}],
        "ScalingParameter" -> OptionValue["ScalingParameter"],
        "Equation" -> classification["Equation"],
        "DressingParameters" -> <||>,
        "ResearchStatus" -> "BareAssignmentFromqRE"|>,
    "BoundaryInference",
      If[!StringQ[family] ||
          classification["Regime"] === "NoVectorKMatrix" ||
          (classification["Regime"] === "NonQuasistandard" &&
            !TrueQ[supportedNonQuasi]),
        Message[CanonicalCoidealParameters::family,
          classification["CandidateFamilies"]];
        Return[Failure["CanonicalParametersRequireUniqueMainFamily", classification]]
      ];
      spectral = Unique["u$"];
      matrixResult = KMatrix[d, spectral,
        "QuantumParameter" -> q,
        "Parameters" -> OptionValue["Parameters"],
        "ScalingParameter" -> OptionValue["ScalingParameter"]];
      If[!AssociationQ[matrixResult] || !MatrixQ[matrixResult["KMatrix"]],
        Return[Failure["CatalogueKMatrixUnavailable", classification]]
      ];
      inferred = InferCoidealParameters[matrixResult["KMatrix"], d, spectral, q,
        "ScalingParameter" -> OptionValue["ScalingParameter"],
        "Equation" -> matrixResult["Equation"],
        "SNodes" -> OptionValue["SNodes"]];
      If[!AssociationQ[inferred] || inferred["ParameterData"] === {},
        Return[Failure["CanonicalParameterInferenceFailed", <|
          "Classification" -> classification, "Inference" -> inferred|>]]
      ];
      chosen = First[inferred["ParameterData"]];
      Join[chosen, <|"Family" -> family,
        "ScalingParameter" -> OptionValue["ScalingParameter"],
        "Equation" -> matrixResult["Equation"], "DressingParameters" -> <||>,
        "BoundaryParameters" -> OptionValue["Parameters"],
        "AlternativeParameterData" -> Rest[inferred["ParameterData"]],
        "Inference" -> inferred,
        "ResearchStatus" -> "InferredFromRepresentedBoundaryEquation"|>],
    _, Failure["UnknownCanonicalParameterMethod", <|"Method" -> method|>]
  ]
];

composePermutations[p_List, q_List] := p[[q + 1]];

dihedralAutomorphisms[size_Integer] := Module[{nodes, rotations, reflections},
  nodes = Range[0, size - 1];
  rotations = Table[Mod[nodes + k, size], {k, 0, size - 1}];
  reflections = Table[Mod[k - nodes, size], {k, 0, size - 1}];
  DeleteDuplicates[Join[rotations, reflections]]
];

involutiveDihedralAutomorphisms[size_Integer] := Module[{nodes, rotations, reflections},
  nodes = Range[0, size - 1];
  rotations = Select[Table[Mod[nodes + k, size], {k, 0, size - 1}],
    #[[# + 1]] === nodes &
  ];
  reflections = Table[Mod[k - nodes, size], {k, 0, size - 1}];
  DeleteDuplicates[Join[rotations, reflections]]
];

involutiveDAutomorphisms[n_Integer] := Module[
  {nodes = Range[0, n], swapLeft, swapRight, reverse, candidates, leaves},
  If[n == 4,
    leaves = {0, 1, 3, 4};
    candidates = Table[ReplacePart[nodes, Thread[(leaves + 1) -> p]], {p, Permutations[leaves]}],
    swapLeft = ReplacePart[nodes, {1 -> 1, 2 -> 0}];
    swapRight = ReplacePart[nodes, {n -> n, n + 1 -> n - 1}];
    reverse = Table[Which[
      i == 0, n - 1, i == 1, n, i == n - 1, 0, i == n, 1,
      True, n - i
    ], {i, 0, n}];
    candidates = DeleteDuplicates@Flatten[Table[
      Fold[composePermutations, nodes, Pick[{swapLeft, swapRight, reverse}, {a, b, c}, 1]],
      {a, 0, 1}, {b, 0, 1}, {c, 0, 1}
    ], 2]
  ];
  Select[candidates, #[[# + 1]] === nodes &]
];

diagramAutomorphisms[type_String, n_Integer] := Switch[canonicalType[type],
  "A(1)", involutiveDihedralAutomorphisms[n + 1],
  "B(1)", {Range[0, n], ReplacePart[Range[0, n], {1 -> 1, 2 -> 0}]},
  "C(1)", {Range[0, n], Reverse[Range[0, n]]},
  "D(1)", involutiveDAutomorphisms[n],
  "A2n-1(2)", {Range[0, n], ReplacePart[Range[0, n], {1 -> 1, 2 -> 0}]},
  "A2n-1(2)T", {Range[0, n], ReplacePart[Range[0, n], {n -> n, n + 1 -> n - 1}]},
  "A2n(2)" | "A2n(2)T", {Range[0, n]},
  "Dn+1(2)", DeleteDuplicates[{Range[0, n], Reverse[Range[0, n]]}],
  _, {}
];

Options[GeneralizedSatakeDiagrams] = {"MaximumEnumerationRank" -> 16};
GeneralizedSatakeDiagrams::rank = "Enumeration at n=`1` is disabled above MaximumEnumerationRank=`2`; raise the option explicitly if desired.";
GeneralizedSatakeDiagrams[type_, n_Integer, OptionsPattern[]] := Module[
  {max = OptionValue["MaximumEnumerationRank"], nodes, taus, candidates},
  If[n > max,
    Message[GeneralizedSatakeDiagrams::rank, n, max]; Return[$Failed]
  ];
  If[CartanMatrixOf[type, n] === $Failed, Return[$Failed]];
  nodes = Range[0, n];
  taus = diagramAutomorphisms[type, n];
  candidates = Flatten[Table[
    Quiet[CreateSatakeDiagram[type, n, x, tau]],
    {tau, taus}, {x, Most[Subsets[nodes]]}
  ], 1];
  Select[candidates, SatakeDiagramQ]
];

SolveBoundaryIntertwiner::length = "left and right must be nonempty lists of the same length.";
SolveBoundaryIntertwiner::dims = "All represented generators must be square matrices of the same dimension.";
Options[SolveBoundaryIntertwiner] = {
  "ParameterHead" -> C,
  "SimplifyFunction" -> Together
};

SolveBoundaryIntertwiner[left_List, right_List, OptionsPattern[]] := Module[
  {dim, k, vars, eqs, arrays, coefficientMatrix, basisVectors, basis,
   parameters, generic, simplify = OptionValue["SimplifyFunction"], head},
  If[left === {} || Length[left] =!= Length[right],
    Message[SolveBoundaryIntertwiner::length]; Return[$Failed]
  ];
  dim = Length[First[left]];
  If[!And @@ (Dimensions[#] === {dim, dim} & /@ Join[left, right]),
    Message[SolveBoundaryIntertwiner::dims]; Return[$Failed]
  ];
  k = Array[Unique["k"] &, {dim, dim}];
  vars = Flatten[k];
  eqs = Flatten@MapThread[k.#1 - #2.k &, {left, right}];
  arrays = CoefficientArrays[eqs, vars];
  If[Length[arrays] =!= 2 || !PossibleZeroQ[Normal[arrays[[1]]]],
    Return[Failure["NonlinearOrInhomogeneousSystem", <|"Equations" -> eqs|>]]
  ];
  coefficientMatrix = arrays[[2]];
  basisVectors = NullSpace[coefficientMatrix];
  basis = Map[ArrayReshape[simplify[#], {dim, dim}] &, basisVectors];
  head = OptionValue["ParameterHead"];
  parameters = Array[head, Length[basis]];
  generic = If[basis === {}, ConstantArray[0, {dim, dim}],
    simplify[Total[MapThread[#1 #2 &, {parameters, basis}]]]
  ];
  <|
    "Dimension" -> Length[basis],
    "Basis" -> basis,
    "Parameters" -> parameters,
    "KMatrix" -> generic,
    "CoefficientMatrix" -> coefficientMatrix,
    "GeneratorCount" -> Length[left]
  |>
];

VerifyBoundaryIntertwiner[k_?MatrixQ, left_List, right_List] /;
    Length[left] == Length[right] := And @@ MapThread[
  zeroMatrixQ[k.#1 - #2.k, True] &,
  {left, right}
];

matrixUnit[labels_List, i_, j_] := Module[{pi, pj, m = Length[labels]},
  pi = FirstPosition[labels, i, Missing["Index", i]];
  pj = FirstPosition[labels, j, Missing["Index", j]];
  If[MissingQ[pi] || MissingQ[pj], Return[$Failed]];
  SparseArray[{First[pi], First[pj]} -> 1, {m, m}]
];

negateLabel["0p"] := "0p";
negateLabel[i_] := -i;

fMatrix[labels_List, theta_, i_, j_] :=
  matrixUnit[labels, i, j] - theta[i] theta[j] matrixUnit[labels, negateLabel[j], negateLabel[i]];

diagonalQPower[h_?MatrixQ, q_] := SparseArray@DiagonalMatrix[q^Diagonal[Normal[h]]];

representationBasis[type_String, n_Integer] := Switch[canonicalType[type],
  "A(1)", Range[1, n + 1],
  "B(1)" | "A2n(2)", Range[-n, n],
  "C(1)" | "D(1)" | "A2n-1(2)" | "A2n-1(2)T",
    Join[Range[-n, -1], Range[1, n]],
  "A2n(2)T", Join[Range[-n, -1], {"0p"}, Range[1, n]],
  "Dn+1(2)", Join[Range[-n, -1], {0, "0p"}, Range[1, n]]
];

finiteKind[type_String] := Switch[canonicalType[type],
  "B(1)" | "A2n(2)" | "Dn+1(2)", "B",
  "C(1)" | "A2n-1(2)" | "A2n(2)T", "C",
  "D(1)" | "A2n-1(2)T", "D",
  "A(1)", "A"
];

VectorRepresentation::type = "A vector representation is not implemented for type `1` at n=`2`.";

VectorRepresentation[type_, n_Integer, z_: z, q_: q] := Module[
  {t = canonicalType[type], a, d, labels, dim, kind, theta, e, f, k, ki,
   unit, fm, affineFM, h, i, bar, cq},
  a = Quiet[CartanMatrixOf[type, n]];
  If[MissingQ[t] || a === $Failed,
    Message[VectorRepresentation::type, type, n]; Return[$Failed]
  ];
  d = SymmetrizersOf[t, n];
  labels = representationBasis[t, n];
  dim = Length[labels];
  kind = finiteKind[t];
  unit[i_, j_] := matrixUnit[labels, i, j];
  If[kind === "A",
    Do[
      e[i] = unit[i, i + 1];
      f[i] = unit[i + 1, i];
      h = unit[i, i] - unit[i + 1, i + 1];
      k[i] = diagonalQPower[h, q]; ki[i] = diagonalQPower[-h, q],
      {i, 1, n}
    ];
    e[0] = z unit[n + 1, 1];
    f[0] = z^-1 unit[1, n + 1];
    h = unit[n + 1, n + 1] - unit[1, 1];
    k[0] = diagonalQPower[h, q]; ki[0] = diagonalQPower[-h, q],
    theta = If[kind === "C", Sign, Function[x, 1]];
    fm[i_, j_] := fMatrix[labels, theta, i, j];
    affineFM[i_, j_] := fMatrix[labels,
      If[MemberQ[{"C(1)", "A2n-1(2)T", "A2n(2)"}, t], Sign, Function[x, 1]],
      i, j
    ];
    Do[
      bar = n + 1 - i;
      e[i] = fm[-bar, -bar + 1];
      f[i] = fm[-bar + 1, -bar];
      h = fm[bar - 1, bar - 1] - fm[bar, bar];
      k[i] = diagonalQPower[h, q]; ki[i] = diagonalQPower[-h, q],
      {i, 1, n - 1}
    ];
    Switch[kind,
      "B",
        cq = Sqrt[q^(1/2) + q^(-1/2)];
        e[n] = cq (unit[-1, 0] - q^(-1/2) unit[0, 1]);
        f[n] = cq (unit[0, -1] - q^(1/2) unit[1, 0]);
        h = -fm[1, 1],
      "C",
        e[n] = fm[-1, 1]/2;
        f[n] = fm[1, -1]/2;
        h = -2 fm[1, 1],
      "D",
        e[n] = fm[-2, 1];
        f[n] = fm[1, -2];
        h = -fm[1, 1] - fm[2, 2]
    ];
    k[n] = diagonalQPower[h, q]; ki[n] = diagonalQPower[-h, q];
    Switch[t,
      "B(1)" | "D(1)" | "A2n-1(2)",
        e[0] = z affineFM[n - 1, -n];
        f[0] = z^-1 affineFM[-n, n - 1];
        h = affineFM[n, n] + affineFM[n - 1, n - 1],
      "C(1)" | "A2n-1(2)T" | "A2n(2)",
        e[0] = z affineFM[n, -n]/2;
        f[0] = z^-1 affineFM[-n, n]/2;
        h = 2 affineFM[n, n],
      "A2n(2)T" | "Dn+1(2)",
        cq = Sqrt[q^(1/2) + q^(-1/2)];
        e[0] = cq z (unit["0p", -n] - q^(1/2) unit[n, "0p"]);
        f[0] = cq z^-1 (unit[-n, "0p"] - q^(-1/2) unit["0p", n]);
        h = fm[n, n]
    ];
    k[0] = diagonalQPower[h, q]; ki[0] = diagonalQPower[-h, q]
  ];
  <|
    "ObjectType" -> "VectorEvaluationRepresentation",
    "AffineType" -> t, "Rank" -> n, "Dimension" -> dim,
    "BasisLabels" -> labels, "SpectralParameter" -> z, "QuantumParameter" -> q,
    "CartanMatrix" -> a, "Symmetrizers" -> d,
    "E" -> Association@Table[i -> e[i], {i, 0, n}],
    "F" -> Association@Table[i -> f[i], {i, 0, n}],
    "K" -> Association@Table[i -> k[i], {i, 0, n}],
    "KInverse" -> Association@Table[i -> ki[i], {i, 0, n}],
    "SourceConvention" -> "qRE/qRE_II homogeneous evaluation representation"
  |>
];

zeroMatrixQ[m_?MatrixQ, assumptions_] := And @@ Flatten[
  PossibleZeroQ[FullSimplify[#, assumptions]] & /@ Normal[m]
];

matrixNonnegativePower[m_?MatrixQ, r_Integer] :=
  If[r == 0, IdentityMatrix[Length[m], SparseArray], MatrixPower[m, r]];
qIntegerSymmetric[r_Integer, q_] := If[r == 0, 0, (q^r - q^-r)/(q - q^-1)];
qFactorialSymmetric[r_Integer, q_] := Product[qIntegerSymmetric[s, q], {s, 1, r}];
qBinomialSymmetric[m_Integer, r_Integer, q_] :=
  qFactorialSymmetric[m, q]/(qFactorialSymmetric[r, q] qFactorialSymmetric[m - r, q]);

Options[VerifyVectorRepresentation] = {
  Assumptions -> True,
  "CheckSerreRelations" -> True
};
VerifyVectorRepresentation[rep_Association, OptionsPattern[]] := Module[
  {a = rep["CartanMatrix"], d = rep["Symmetrizers"], e = rep["E"],
   f = rep["F"], k = rep["K"], ki = rep["KInverse"], q = rep["QuantumParameter"],
   n = rep["Rank"], assumptions = OptionValue[Assumptions], cartan, commutators,
   serre = True, qi, m, lhs, i, j},
  cartan = And @@ Flatten@Table[
    zeroMatrixQ[k[i].e[j].ki[i] - q^(d[[i + 1]] a[[i + 1, j + 1]]) e[j], assumptions] &&
    zeroMatrixQ[k[i].f[j].ki[i] - q^(-d[[i + 1]] a[[i + 1, j + 1]]) f[j], assumptions],
    {i, 0, n}, {j, 0, n}
  ];
  commutators = And @@ Flatten@Table[
    qi = q^d[[i + 1]];
    zeroMatrixQ[e[i].f[j] - f[j].e[i] -
      If[i == j, (k[i] - ki[i])/(qi - qi^-1), 0 k[i]], assumptions],
    {i, 0, n}, {j, 0, n}
  ];
  If[TrueQ[OptionValue["CheckSerreRelations"]],
    serre = And @@ Flatten@Table[
      If[i == j, True,
        m = 1 - a[[i + 1, j + 1]];
        qi = q^d[[i + 1]];
        lhs = Sum[(-1)^r qBinomialSymmetric[m, r, qi]
          matrixNonnegativePower[e[i], m - r].e[j].matrixNonnegativePower[e[i], r],
          {r, 0, m}];
        zeroMatrixQ[lhs, assumptions]
      ],
      {i, 0, n}, {j, 0, n}
    ]
  ];
  <|"CartanRelations" -> cartan, "CommutatorRelations" -> commutators,
    "SerreRelations" -> serre, "Valid" -> TrueQ[cartan && commutators && serre]|>
];

DualVectorRepresentation[rep_Association] := Module[
  {n = rep["Rank"], e = rep["E"], f = rep["F"], k = rep["K"],
   ki = rep["KInverse"], dual},
  dual = Association[rep];
  dual["ObjectType"] = "DualVectorEvaluationRepresentation";
  dual["E"] = Association@Table[i -> Transpose[-ki[i].e[i]], {i, 0, n}];
  dual["F"] = Association@Table[i -> Transpose[-f[i].k[i]], {i, 0, n}];
  dual["K"] = Association@Table[i -> Transpose[ki[i]], {i, 0, n}];
  dual["KInverse"] = Association@Table[i -> Transpose[k[i]], {i, 0, n}];
  dual["SourceConvention"] = "Transpose of the antipode composed with vector evaluation representation";
  dual
];

braidImageE[rep_Association, i_Integer, j_Integer] := Module[
  {a = rep["CartanMatrix"], d = rep["Symmetrizers"], e = rep["E"],
   f = rep["F"], k = rep["K"], q = rep["QuantumParameter"], m, qi},
  If[i == j, Return[-f[i].k[i]]];
  m = -a[[i + 1, j + 1]];
  If[m == 0, Return[e[j]]];
  qi = q^d[[i + 1]];
  Sum[(-qi)^(-r)
    matrixNonnegativePower[e[i], m - r].e[j].matrixNonnegativePower[e[i], r]/
      (qFactorialSymmetric[m - r, qi] qFactorialSymmetric[r, qi]),
    {r, 0, m}]
];

braidImageF[rep_Association, i_Integer, j_Integer] := Module[
  {a = rep["CartanMatrix"], d = rep["Symmetrizers"], e = rep["E"],
   f = rep["F"], ki = rep["KInverse"], q = rep["QuantumParameter"], m, qi},
  If[i == j, Return[-ki[i].e[i]]];
  m = -a[[i + 1, j + 1]];
  If[m == 0, Return[f[j]]];
  qi = q^d[[i + 1]];
  Sum[(-qi)^r
    matrixNonnegativePower[f[i], r].f[j].matrixNonnegativePower[f[i], m - r]/
      (qFactorialSymmetric[r, qi] qFactorialSymmetric[m - r, qi]),
    {r, 0, m}]
];

braidImageK[rep_Association, i_Integer, j_Integer] := Module[
  {a = rep["CartanMatrix"], k = rep["K"], ki = rep["KInverse"], exponent},
  If[i == j, Return[ki[i]]];
  exponent = -a[[i + 1, j + 1]];
  k[j].matrixNonnegativePower[k[i], exponent]
];

BraidOperator::solution = "The braid intertwiner for node `1` has solution-space dimension `2`, expected 1.";
Options[BraidOperator] = {"SimplifyFunction" -> Together};
BraidOperator[rep_Association, i_Integer, OptionsPattern[]] := Module[
  {n = rep["Rank"], left, right, solved, basis},
  If[!MemberQ[Range[0, n], i], Return[$Failed]];
  left = Flatten[Table[{rep["E"][j], rep["F"][j], rep["K"][j]}, {j, 0, n}], 1];
  right = Flatten[Table[{braidImageE[rep, i, j], braidImageF[rep, i, j], braidImageK[rep, i, j]}, {j, 0, n}], 1];
  solved = SolveBoundaryIntertwiner[left, right,
    "SimplifyFunction" -> OptionValue["SimplifyFunction"]];
  If[!AssociationQ[solved], Return[solved]];
  basis = solved["Basis"];
  If[Length[basis] =!= 1,
    Message[BraidOperator::solution, i, Length[basis]];
    Return[Failure["UnexpectedBraidOperatorDimension", <|"Node" -> i, "Dimension" -> Length[basis]|>]]
  ];
  First[basis]
];

DiagramAutomorphismIntertwiner::perm = "`1` is not an affine Dynkin diagram automorphism of type `2` at rank `3`.";
Options[DiagramAutomorphismIntertwiner] = {"SimplifyFunction" -> Together};
DiagramAutomorphismIntertwiner[type_String, n_Integer, sigma_List, z_, q_: q,
    OptionsPattern[]] := Module[
  {t = canonicalType[type], a, rep, left, right, solved},
  a = Quiet[CartanMatrixOf[type, n]];
  If[MissingQ[t] || a === $Failed || Sort[sigma] =!= Range[0, n] ||
      a[[sigma + 1, sigma + 1]] =!= a,
    Message[DiagramAutomorphismIntertwiner::perm, sigma, type, n];
    Return[Failure["NotDiagramAutomorphism", <|
      "AffineType" -> type, "Rank" -> n, "Permutation" -> sigma|>]]
  ];
  rep = VectorRepresentation[t, n, z, q];
  left = Flatten[Table[
    {rep["E"][i], rep["F"][i], rep["K"][i]}, {i, 0, n}], 1];
  right = Flatten[Table[
    {rep["E"][sigma[[i + 1]]], rep["F"][sigma[[i + 1]]],
      rep["K"][sigma[[i + 1]]]}, {i, 0, n}], 1];
  solved = SolveBoundaryIntertwiner[left, right,
    "SimplifyFunction" -> OptionValue["SimplifyFunction"]];
  If[!AssociationQ[solved] || solved["Dimension"] =!= 1,
    Return[Failure["DiagramAutomorphismNotImplementedInRepresentation", <|
      "AffineType" -> t, "Rank" -> n, "Permutation" -> sigma,
      "IntertwinerSolve" -> solved|>]]
  ];
  Join[solved, <|"Intertwiner" -> First[solved["Basis"]],
    "AffineType" -> t, "Rank" -> n, "Permutation" -> sigma,
    "SpectralParameter" -> z, "QuantumParameter" -> q,
    "BasisLabels" -> rep["BasisLabels"],
    "Provenance" -> "DerivedFromChevalleyGeneratorConjugation"|>]
];

representedLongestOperator[rep_Association, diagram_Association] := Module[
  {word, operator, si},
  word = LongestParabolicWord[diagram["CartanMatrix"], diagram["X"]];
  operator = IdentityMatrix[rep["Dimension"], SparseArray];
  Do[
    si = BraidOperator[rep, i];
    If[!MatrixQ[si], Return[si]];
    operator = operator.si,
    {i, word}
  ];
  operator
];

parameterByNode[data_, i_Integer, defaultHead_] := Which[
  AssociationQ[data], Lookup[data, i, defaultHead[i]],
  ListQ[data] && Length[data] >= i + 1, data[[i + 1]],
  True, defaultHead[i]
];

RepresentedQPGenerators::diagram = "The first argument must be a valid generalized Satake diagram.";
Options[RepresentedQPGenerators] = {
  "ScalingParameter" -> 1,
  "RepresentationForm" -> "Direct"
};
RepresentedQPGenerators[diagram_Association, z_, q_: q, c_: <||>, s_: <||>, OptionsPattern[]] := Module[
  {n, x, tau, rep, names = {}, matrices = {}, root, ci, si, i, orbitReps, eta,
   longestOperator, longestOperatorInverse},
  If[!SatakeDiagramQ[diagram], Message[RepresentedQPGenerators::diagram]; Return[$Failed]];
  n = diagram["Rank"]; x = diagram["X"]; tau = diagram["Tau"];
  eta = OptionValue["ScalingParameter"];
  rep = VectorRepresentation[diagram["AffineType"], n, eta z, q];
  If[OptionValue["RepresentationForm"] === "DualAntipodeTranspose",
    rep = DualVectorRepresentation[rep]
  ];
  longestOperator = representedLongestOperator[rep, diagram];
  If[!MatrixQ[longestOperator], Return[longestOperator]];
  longestOperatorInverse = Inverse[longestOperator];
  Do[
    If[MemberQ[x, i],
      AppendTo[names, {"E", i}]; AppendTo[matrices, rep["E"][i]];
      AppendTo[names, {"B", i}]; AppendTo[matrices, rep["F"][i]],
      ci = parameterByNode[c, i, Function[node, Symbol["c" <> ToString[node]]]];
      si = parameterByNode[s, i, Function[node, 0]];
      root = Together[longestOperator.rep["E"][tau[[i + 1]]].longestOperatorInverse];
      AppendTo[names, {"B", i}];
      AppendTo[matrices, Together[rep["F"][i] - ci root.rep["KInverse"][i] - si rep["KInverse"][i]]]
    ],
    {i, 0, n}
  ];
  Do[
    AppendTo[names, {"K", i}]; AppendTo[matrices, rep["K"][i]],
    {i, x}
  ];
  orbitReps = DeleteDuplicates[Min[#, tau[[# + 1]]] & /@ Complement[Range[0, n], x]];
  Do[
    If[tau[[i + 1]] =!= i,
      AppendTo[names, {"KRatio", i, tau[[i + 1]]}];
      AppendTo[matrices, rep["K"][i].rep["KInverse"][tau[[i + 1]]]]
    ],
    {i, orbitReps}
  ];
  <|"Names" -> names, "Matrices" -> matrices, "Representation" -> rep,
    "CParameters" -> c, "SParameters" -> s, "ScalingParameter" -> eta|>
];

Options[DeriveKMatrix] = {
  "ScalingParameter" -> 1,
  "SimplifyFunction" -> Together,
  "NormalizeAt" -> None,
  "Equation" -> Automatic
};
DeriveKMatrix[diagram_Association, u_, q_: q, c_: <||>, s_: <||>, OptionsPattern[]] := Module[
  {left, solved, firstSolved, secondSolved, preferred, alternate,
   equation = OptionValue["Equation"],
   normalize = OptionValue["NormalizeAt"], matrix, value, pivot, solveFor},
  left = RepresentedQPGenerators[diagram, u, q, c, s,
    "ScalingParameter" -> OptionValue["ScalingParameter"]];
  If[!AssociationQ[left], Return[$Failed]];
  solveFor[eq_] := Module[{right, answer},
    right = RepresentedQPGenerators[diagram, u^-1, q, c, s,
      "ScalingParameter" -> OptionValue["ScalingParameter"],
      "RepresentationForm" -> If[eq === "Transposed",
        "DualAntipodeTranspose", "Direct"]];
    If[!AssociationQ[right], Return[$Failed]];
    If[left["Names"] =!= right["Names"],
      Return[Failure["GeneratorMismatch", <|"Equation" -> eq|>]]];
    answer = SolveBoundaryIntertwiner[left["Matrices"], right["Matrices"],
      "SimplifyFunction" -> OptionValue["SimplifyFunction"]];
    If[AssociationQ[answer], Join[answer, <|"GeneratorNames" -> left["Names"],
      "Diagram" -> diagram, "Equation" -> eq,
      "Provenance" -> "DerivedBoundaryIntertwiner"|>], answer]
  ];
  solved = Switch[equation,
    "Standard" | "Transposed", solveFor[equation],
    Automatic,
      preferred = BoundaryEquationType[diagram];
      alternate = If[preferred === "Standard", "Transposed", "Standard"];
      firstSolved = solveFor[preferred];
      If[AssociationQ[firstSolved] && firstSolved["Dimension"] == 1, firstSolved,
        secondSolved = solveFor[alternate];
        Which[
          AssociationQ[secondSolved] && secondSolved["Dimension"] == 1, secondSolved,
          AssociationQ[firstSolved] && firstSolved["Dimension"] > 0, firstSolved,
          True, secondSolved
        ]
      ],
    _, Return[Failure["UnknownBoundaryEquation", <|"Equation" -> equation|>]]
  ];
  If[!AssociationQ[solved], Return[solved]];
  If[normalize =!= None && solved["Dimension"] == 1,
    matrix = First[solved["Basis"]];
    value = Normal[matrix] /. u -> normalize;
    pivot = Select[Flatten[value], !PossibleZeroQ[#] &];
    If[pivot =!= {}, AssociateTo[solved, "NormalizedKMatrix" -> Together[matrix/First[pivot]]]]
  ];
  solved
];

Options[VerifyKMatrix] = {
  "ScalingParameter" -> 1,
  "Equation" -> Automatic
};
VerifyKMatrix[matrix_?MatrixQ, diagram_?SatakeDiagramQ, u_, q_: q,
    c_: <||>, s_: <||>, OptionsPattern[]] := Module[
  {equation = OptionValue["Equation"], left, right},
  If[equation === Automatic, equation = BoundaryEquationType[diagram]];
  If[!MemberQ[{"Standard", "Transposed"}, equation], Return[False]];
  left = RepresentedQPGenerators[diagram, u, q, c, s,
    "ScalingParameter" -> OptionValue["ScalingParameter"]];
  right = RepresentedQPGenerators[diagram, u^-1, q, c, s,
    "ScalingParameter" -> OptionValue["ScalingParameter"],
    "RepresentationForm" -> If[equation === "Transposed",
      "DualAntipodeTranspose", "Direct"]];
  If[!AssociationQ[left] || !AssociationQ[right] || left["Names"] =!= right["Names"],
    Return[False]
  ];
  VerifyBoundaryIntertwiner[matrix, left["Matrices"], right["Matrices"]]
];

Options[InferCoidealParameters] = {
  "ScalingParameter" -> 1,
  "Equation" -> Automatic,
  "SNodes" -> Automatic,
  "RequireSpectralIndependence" -> True,
  "SimplifyFunction" -> Together
};
InferCoidealParameters[matrix_?MatrixQ, diagram_?SatakeDiagramQ, u_, q_: q,
    OptionsPattern[]] := Module[
  {outside, tau, equation = OptionValue["Equation"], sNodes, cVariables,
   sVariables, cParameters, sParameters, variables, left, right, residuals,
   scalarEquations, solutions, parameterData, simplify},
  outside = Complement[diagram["Nodes"], diagram["X"]];
  tau = diagram["Tau"];
  sNodes = Switch[OptionValue["SNodes"],
    Automatic, Select[outside, tau[[# + 1]] === # &],
    All, outside,
    None | False, {},
    nodes_List, Intersection[outside, nodes],
    _, Return[Failure["InvalidSNodes", <|"Value" -> OptionValue["SNodes"]|>]]
  ];
  cVariables = Association@Table[i -> Unique["c" <> ToString[i] <> "$"],
    {i, outside}];
  sVariables = Association@Table[i -> Unique["s" <> ToString[i] <> "$"],
    {i, sNodes}];
  cParameters = cVariables;
  sParameters = Association@Table[i -> Lookup[sVariables, i, 0], {i, outside}];
  variables = Join[Values[cVariables], Values[sVariables]];
  If[equation === Automatic, equation = BoundaryEquationType[diagram]];
  If[!MemberQ[{"Standard", "Transposed"}, equation],
    Return[Failure["UnknownBoundaryEquation", <|"Equation" -> equation|>]]
  ];
  left = RepresentedQPGenerators[diagram, u, q, cParameters, sParameters,
    "ScalingParameter" -> OptionValue["ScalingParameter"]];
  right = RepresentedQPGenerators[diagram, u^-1, q, cParameters, sParameters,
    "ScalingParameter" -> OptionValue["ScalingParameter"],
    "RepresentationForm" -> If[equation === "Transposed",
      "DualAntipodeTranspose", "Direct"]];
  If[!AssociationQ[left] || !AssociationQ[right] ||
      left["Names"] =!= right["Names"],
    Return[Failure["GeneratorConstructionFailed", <|"Equation" -> equation|>]]
  ];
  simplify = OptionValue["SimplifyFunction"];
  residuals = MapThread[matrix.#1 - #2.matrix &,
    {left["Matrices"], right["Matrices"]}];
  scalarEquations = DeleteDuplicates@DeleteCases[
    Numerator[simplify[#]] & /@ Flatten[Normal /@ residuals], 0];
  solutions = If[scalarEquations === {}, {{}},
    Quiet[Solve[Thread[scalarEquations == 0], variables], Solve::svars]
  ];
  If[TrueQ[OptionValue["RequireSpectralIndependence"]] && ListQ[solutions],
    solutions = Select[solutions, FreeQ[#, u] &]
  ];
  If[solutions === {} || !ListQ[solutions],
    Return[Failure["NoCompatibleCoidealParameters", <|
      "Equation" -> equation, "EquationCount" -> Length[scalarEquations]|>]]
  ];
  parameterData = Map[
    <|"CParameters" -> Association@Table[i -> (cParameters[i] /. #), {i, outside}],
      "SParameters" -> Association@Table[i -> (sParameters[i] /. #), {i, outside}],
      "Rules" -> #,
      "FreeVariables" -> Complement[variables, First /@ #]|> &,
    solutions
  ];
  <|"Equation" -> equation, "ScalingParameter" -> OptionValue["ScalingParameter"],
    "CVariables" -> cVariables, "SVariables" -> sVariables,
    "Equations" -> Thread[scalarEquations == 0], "Solutions" -> solutions,
    "ParameterData" -> parameterData, "SolutionCount" -> Length[solutions],
    "GeneratorNames" -> left["Names"],
    "Provenance" -> "InferredFromRepresentedBoundaryEquation"|>
];

