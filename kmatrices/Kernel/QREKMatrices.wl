  "A.1" -> <|"AffineType" -> "A(1)", "Kind" -> "Plain", "Equation" -> "Transposed", "Implementation" -> "ClosedForm", "ResearchStatus" -> "qREFormula"|>,
  "A.2" -> <|"AffineType" -> "A(1)", "Kind" -> "Alternating", "Equation" -> "Transposed", "Implementation" -> "ClosedForm", "ResearchStatus" -> "qREFormula"|>,
  "A.3" -> <|"AffineType" -> "A(1)", "Kind" -> "Reflecting", "Equation" -> "Standard", "Implementation" -> "ClosedForm", "ResearchStatus" -> "qREFormula"|>,
  "A.4" -> <|"AffineType" -> "A(1)", "Kind" -> "Rotational", "Equation" -> "Transposed", "Implementation" -> "ClosedForm", "ResearchStatus" -> "qREFormula"|>,
