    "Implementation" -> "PartialClosedForm",
    "ImplementedFamilies" -> {"C.1", "B*.1", "tB*.1", "C**.1", "tC**.1", "C*.1"},
    "ImplementedRegime" -> "Generic r=l+2 branches and manuscript-complete B*.1, C**.1, tC**.1, and C*.1 endpoints",
